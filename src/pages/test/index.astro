---
import { getEntries } from "astro:content";

import Eye from "@/components/eye.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { CDN_URL, HOMEPAGE_PROJECTS } from "@/scripts/constants";

const projects = await getEntries(
  HOMEPAGE_PROJECTS.map((id) => {
    return { collection: "projects", id };
  }),
);
---

<BaseLayout meta={{ kind: "route", route: "home", description: "NEW" }}>
  <header class="constrain mt-6 sm:mt-20">
    <nav class="sm:w-(--prose-w)">
      <a
        href="/"
        title="Home"
        aria-label="Go to the homepage"
        class="group flex w-fit items-center gap-1.5"
      >
        <Eye
          size={3.5}
          class="fill-sweater-5 group-hover:fill-sweater-4 light:fill-sweater-6 light:group-hover:fill-sweater-7"
        />
        <span
          class="text-lg/1 leading-none font-medium text-sweater-5 group-hover:text-sweater-4 light:text-sweater-6 light:group-hover:text-sweater-7"
        >
          Charles Wang
        </span>
      </a>

      <div
        class="mt-4 flex gap-4 border-t-2 border-dashed border-line pt-0.5 *:text-link-primary *:hover:text-link-primary-hover"
      >
        <a href="/index">Index</a>
        <a href="/projects">Projects</a>
        <a href="/posts">Writing</a>
        <a href="/about">About</a>
      </div>
    </nav>
  </header>

  <main class="mt-4">
    <div class="constrain space-y-3 *:sm:w-(--prose-w)">
      <p>
        Hi, welcome. Thanks for visiting my little space. I wonder how you ended
        up here? Regardless, please do take a look around and explore.
      </p>
      <p>Here's some stuff I've made that I'm proud of...</p>
    </div>

    <section
      aria-label="Some projects I made"
      class="constrain mt-5 grid grid-cols-3 gap-3"
    >
      {
        projects.map(({ id, data }) => {
          const path = `${CDN_URL}/projects/${id}`;

          return (
            <article class="relative space-y-1">
              <video
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                class="rounded-sm"
              >
                <source src={`${path}/cover.webm`} type="video/webm" />
                <source src={`${path}/cover.mp4`} type="video/mp4" />
              </video>
              <h2>
                <a href="/" class="after:absolute after:inset-0 after:z-1">
                  {data.subtitle ? data.subtitle : "<No subtitle>"}
                </a>
              </h2>
            </article>
          );
        })
      }
    </section>

    <section class="constrain mt-5 space-y-1">
      <p>Awesome canvases</p>

      <div class="grid grid-cols-3 gap-3">
        {
          Array.from({ length: 3 }).map((_, index) => (
            <article class="relative space-y-1">
              <canvas
                id={`tile-${index}`}
                class="aspect-16/10 w-full rounded-sm bg-sweater-9"
              />
              <h2>
                <a href="/" class="after:absolute after:inset-0 after:z-1">
                  [No subtitle]
                </a>
              </h2>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import vertSource from "@/shaders/quad.vert.glsl?raw";
  import fragSource from "@/shaders/new.frag.glsl?raw";

  const run = () => {
    const tile0Canvas = document.getElementById("tile-0") as HTMLCanvasElement;
    const bitmapCtx0 = tile0Canvas.getContext("bitmaprenderer");

    const offCanvas = new OffscreenCanvas(1280, 800);
    const gl = offCanvas.getContext("webgl2", {
      depth: false,
      stencil: false,
      antialias: false,
    });

    if (!gl || !bitmapCtx0) return;

    const createShader = (type: GLenum, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);

      if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;

      console.error("Error compiling shader:", gl.getShaderInfoLog(shader));
      return null;
    };

    const vertShader = createShader(gl.VERTEX_SHADER, vertSource);
    const fragShader = createShader(gl.FRAGMENT_SHADER, fragSource);

    if (!vertShader || !fragShader) return;

    const program = gl.createProgram();
    gl.attachShader(program, vertShader);
    gl.attachShader(program, fragShader);
    gl.linkProgram(program);

    gl.deleteShader(vertShader);
    gl.deleteShader(fragShader);

    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error("Error linking program:", gl.getProgramInfoLog(program));
      gl.deleteProgram(program);
      return;
    }

    gl.useProgram(program);

    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);

    const dimensionsUnifLoc = gl.getUniformLocation(program, "u_dimensions");
    const timeUnifLoc = gl.getUniformLocation(program, "u_time");

    const ditherModeUnifLoc = gl.getUniformLocation(program, "u_dither_mode");
    const uvPixelSizeUnifLoc = gl.getUniformLocation(
      program,
      "u_uv_pixel_size",
    );
    const numQuantizedColorsUnifLoc = gl.getUniformLocation(
      program,
      "u_num_quantized_colors",
    );
    const biasUnifLoc = gl.getUniformLocation(program, "u_bias");

    const bayerMatrixSizeUnifLoc = gl.getUniformLocation(
      program,
      "u_bayer_matrix_size",
    );
    const orderedDitherSizeUnifLoc = gl.getUniformLocation(
      program,
      "u_ordered_dither_size",
    );

    const colorAUnifLoc = gl.getUniformLocation(program, "u_color_a");
    const colorBUnifLoc = gl.getUniformLocation(program, "u_color_b");

    const draw: FrameRequestCallback = (now) => {
      const time = now * 0.001;

      // https://webgl2fundamentals.org/webgl/lessons/webgl-resizing-the-canvas.html
      if (
        offCanvas.width !== tile0Canvas.clientWidth ||
        offCanvas.height !== tile0Canvas.clientHeight
      ) {
        offCanvas.width = tile0Canvas.clientWidth;
        offCanvas.height = tile0Canvas.clientHeight;

        gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);
        gl.uniform2i(dimensionsUnifLoc, gl.canvas.width, gl.canvas.height);
      }
      gl.uniform1f(timeUnifLoc, time);

      gl.uniform1i(ditherModeUnifLoc, 1); // ordered
      gl.uniform1i(uvPixelSizeUnifLoc, 48);
      gl.uniform1i(numQuantizedColorsUnifLoc, 4);
      gl.uniform1f(biasUnifLoc, 0);

      gl.uniform1i(bayerMatrixSizeUnifLoc, 2); // 8x8
      gl.uniform1i(orderedDitherSizeUnifLoc, 6);

      gl.uniform3f(
        colorAUnifLoc,
        0.0392156862745098,
        0.03529411764705882,
        0.09803921568627451,
      );
      gl.uniform3f(
        colorBUnifLoc,
        0.19215686274509805,
        0.17647058823529413,
        0.396078431372549,
      );

      gl.clearColor(0.0, 0.0, 0.0, 0.0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      bitmapCtx0.transferFromImageBitmap(offCanvas.transferToImageBitmap());

      requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);
  };

  run();
</script>
