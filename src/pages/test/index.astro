---
import { getEntries } from "astro:content";

import Eye from "@/components/eye.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { HOMEPAGE_PROJECTS } from "@/scripts/constants";

const projects = await getEntries(
  HOMEPAGE_PROJECTS.map((id) => {
    return { collection: "projects", id };
  }),
);
---

<BaseLayout meta={{ kind: "route", route: "home", description: "NEW" }}>
  <header class="constrain mt-6 sm:mt-20">
    <nav class="sm:w-(--prose-w)">
      <a
        href="/"
        title="Home"
        aria-label="Go to the homepage"
        class="group flex w-fit items-center gap-1.5"
      >
        <Eye
          size={3.5}
          class="fill-sweater-5 group-hover:fill-sweater-4 light:fill-sweater-6 light:group-hover:fill-sweater-7"
        />
        <span class="text-lg/1 leading-none font-medium text-sweater-5 group-hover:text-sweater-4 light:text-sweater-6 light:group-hover:text-sweater-7">
          Charles Wang
        </span>
      </a>

      <div class="mt-4 flex gap-4 border-t-2 border-dashed border-line pt-0.5 *:text-link-primary *:hover:text-link-primary-hover">
        <a href="/index">Index</a>
        <a href="/projects">Projects</a>
        <a href="/posts">Writing</a>
        <a href="/about">About</a>
      </div>
    </nav>
  </header>

  <main class="mt-4">
    <div class="constrain space-y-3 *:sm:w-(--prose-w)">
      <p>
        Hi, welcome. Thanks for visiting my little space. I wonder how you ended
        up here? Please do take a look around and explore.
      </p>
      <p>Here's some stuff I've made that I'm proud of...</p>
    </div>

    <section
      class="constrain mt-5 space-y-1 grid grid-cols-3 gap-3"
      aria-label="Some projects I made"
    >
      {projects.map(({ id, data: { subtitle } }, index) => (
        <article class="relative space-y-1 group">
          <canvas
            id={`tile-${index}`}
            class="aspect-16/10 w-full rounded-sm bg-sweater-9"
            data-project-id={id}
          />
          <h2>
            <a
              href={`/projects/${id}`}
              class="after:absolute after:inset-0 after:z-1 text-link-primary group-hover:text-link-primary-hover font-medium"
            >
              {subtitle ? subtitle : "<NO SUBTITLE>"}
            </a>
          </h2>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  import vertSource from "@/shaders/quad.vert.glsl?raw";
  import fragSource from "@/shaders/new.frag.glsl?raw";

  import { CDN_URL, HOMEPAGE_PROJECTS } from "@/scripts/constants";
  import type { Tile } from "@/scripts/dither/types";

  const run = () => {
    const offCanvas = new OffscreenCanvas(1280, 800);
    const gl = offCanvas.getContext("webgl2", {
      depth: false,
      stencil: false,
      antialias: false,
    });

    if (!gl) return;

    const tiles: (Tile | null)[] = HOMEPAGE_PROJECTS.map((_, index) => {
      const tileCanvas = document.getElementById(
        `tile-${index}`,
      ) as HTMLCanvasElement;
      const bitmapCtx = tileCanvas.getContext("bitmaprenderer");

      if (!bitmapCtx) return null;

      const projectId = tileCanvas.dataset["projectId"]!;
      const videoElt = document.createElement("video");
      videoElt.crossOrigin = "anonymous";
      videoElt.src = `${CDN_URL}/projects/${projectId}/cover.mp4`;
      videoElt.muted = true;
      // Prevents video from autoplaying in fullscreen on page load on iOS
      videoElt.playsInline = true;
      videoElt.loop = true;
      videoElt.playbackRate = 0.35;
      videoElt.play();

      const videoFrameTex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, videoFrameTex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);

      const tile: Tile = {
        canvas: tileCanvas,
        bitmapCtx,
        videoElt,
        videoLoaded: false,
        videoFrameTex,
        state: { kind: "init", delay: index * 0.15 },
      };

      const checkIfVideoIsLoaded = () => {
        if (
          videoElt.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA &&
          !tile.videoLoaded
        ) {
          tile.videoLoaded = true;
        }
      };
      videoElt.addEventListener("progress", checkIfVideoIsLoaded);
      videoElt.addEventListener("canplaythrough", checkIfVideoIsLoaded);

      return tile;
    });

    if (!tiles.every((tile) => tile !== null)) return;

    // Automatically resume playing videos if they were paused somehow
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") return;

      tiles.forEach(({ videoElt }) => {
        if (videoElt.paused) videoElt.play();
      });
    });

    const createShader = (type: GLenum, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);

      if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;

      console.error("Error compiling shader:", gl.getShaderInfoLog(shader));
      return null;
    };

    const vertShader = createShader(gl.VERTEX_SHADER, vertSource);
    const fragShader = createShader(gl.FRAGMENT_SHADER, fragSource);

    if (!vertShader || !fragShader) return;

    const program = gl.createProgram();
    gl.attachShader(program, vertShader);
    gl.attachShader(program, fragShader);
    gl.linkProgram(program);

    gl.deleteShader(vertShader);
    gl.deleteShader(fragShader);

    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error("Error linking program:", gl.getProgramInfoLog(program));
      gl.deleteProgram(program);
      return;
    }

    gl.useProgram(program);
    gl.activeTexture(gl.TEXTURE0);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);

    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);

    const videoFrameUnifLoc = gl.getUniformLocation(program, "u_video_frame");

    const dimensionsUnifLoc = gl.getUniformLocation(program, "u_dimensions");
    const timeUnifLoc = gl.getUniformLocation(program, "u_time");

    const ditherModeUnifLoc = gl.getUniformLocation(program, "u_dither_mode");
    const uvPixelSizeUnifLoc = gl.getUniformLocation(
      program,
      "u_uv_pixel_size",
    );
    const numQuantizedColorsUnifLoc = gl.getUniformLocation(
      program,
      "u_num_quantized_colors",
    );
    const biasUnifLoc = gl.getUniformLocation(program, "u_bias");
    const speedUnifLoc = gl.getUniformLocation(program, "u_speed");
    const mixUnifLoc = gl.getUniformLocation(program, "u_mix");

    const bayerMatrixSizeUnifLoc = gl.getUniformLocation(
      program,
      "u_bayer_matrix_size",
    );
    const orderedDitherSizeUnifLoc = gl.getUniformLocation(
      program,
      "u_ordered_dither_size",
    );

    const colorAUnifLoc = gl.getUniformLocation(program, "u_color_a");
    const colorBUnifLoc = gl.getUniformLocation(program, "u_color_b");

    gl.uniform1i(videoFrameUnifLoc, 0);

    gl.uniform1i(ditherModeUnifLoc, 1); // ordered
    gl.uniform1i(uvPixelSizeUnifLoc, 48);
    gl.uniform1i(numQuantizedColorsUnifLoc, 4);
    gl.uniform1f(biasUnifLoc, 0);
    gl.uniform1f(speedUnifLoc, 0.25);
    gl.uniform1f(mixUnifLoc, 0);

    gl.uniform1i(bayerMatrixSizeUnifLoc, 2); // 8x8
    gl.uniform1i(orderedDitherSizeUnifLoc, 6);

    gl.uniform3f(colorAUnifLoc, 0.11372, 0.09803, 0.23921);
    gl.uniform3f(colorBUnifLoc, 0.28235, 0.26274, 0.5647);

    const lerp = (a: number, b: number, t: number): number => {
      return a * (1 - t) + b * t;
    };

    // The timestamp at which the draw loop actually begins running, which
    // will always likely be lagging behind page load
    const drawStartTime = performance.now() * 0.001;

    const draw: FrameRequestCallback = (now) => {
      const elapsed = Math.max(now * 0.001 - drawStartTime, 0);

      gl.uniform1f(timeUnifLoc, elapsed);

      tiles.forEach((tile) => {
        const { canvas: tileCanvas, bitmapCtx, videoElt, videoFrameTex } = tile;

        // https://webgl2fundamentals.org/webgl/lessons/webgl-resizing-the-canvas.html
        if (
          offCanvas.width !== tileCanvas.clientWidth ||
          offCanvas.height !== tileCanvas.clientHeight
        ) {
          offCanvas.width = tileCanvas.clientWidth;
          offCanvas.height = tileCanvas.clientHeight;

          gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);
          gl.uniform2i(dimensionsUnifLoc, gl.canvas.width, gl.canvas.height);
        }

        let biasValue = -1;
        let mixValue = 0;

        switch (tile.state.kind) {
          case "init": {
            mixValue = 0;

            const offsetElapsed = elapsed - tile.state.delay;

            if (offsetElapsed < 0) break;

            const t = offsetElapsed / 1.75;

            if (t <= 1) {
              biasValue = lerp(-1, 0, 1 - Math.pow(1 - t, 5));
            } else {
              biasValue = 0;
              tile.state = { kind: "procedural" };

              const uploadVideoFrame: VideoFrameRequestCallback = () => {
                gl.bindTexture(gl.TEXTURE_2D, videoFrameTex);
                gl.texImage2D(
                  gl.TEXTURE_2D,
                  0,
                  gl.RGBA,
                  gl.RGBA,
                  gl.UNSIGNED_BYTE,
                  videoElt,
                );

                videoElt.requestVideoFrameCallback(uploadVideoFrame);
              };

              videoElt.requestVideoFrameCallback(uploadVideoFrame);
            }

            break;
          }

          case "procedural": {
            biasValue = 0;
            mixValue = 0;

            if (tile.videoLoaded) {
              tile.state = { kind: "video-loaded", loadStartTime: elapsed };
            }

            break;
          }

          case "video-loaded": {
            biasValue = 0;
            mixValue = 0;

            const offsetElapsed = elapsed - tile.state.loadStartTime;
            const t = Math.max(offsetElapsed / 1.75, 0);

            if (t <= 1) {
              mixValue = t;
            } else {
              mixValue = 1;
              tile.state = { kind: "video" };
            }

            break;
          }

          case "video": {
            biasValue = 0;
            mixValue = 1;
            break;
          }
        }

        gl.uniform1f(biasUnifLoc, biasValue);
        gl.uniform1f(mixUnifLoc, mixValue);

        gl.clearColor(0.0, 0.0, 0.0, 0.0);
        gl.bindTexture(gl.TEXTURE_2D, videoFrameTex);
        gl.drawArrays(gl.TRIANGLES, 0, 3);

        bitmapCtx.transferFromImageBitmap(offCanvas.transferToImageBitmap());
      });

      requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);
  };

  run();
</script>
