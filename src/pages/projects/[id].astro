---
import { getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths } from "astro";

import {
  CalendarFoldIcon,
  ExternalLinkIcon,
  FileCodeIcon,
  WrenchIcon,
} from "@lucide/astro";

import BaseLayout from "@/layouts/base-layout.astro";
import MdxContent from "@/components/mdx-content.astro";
import ProjectCover from "@/components/project-cover.astro";
import TechList from "@/components/tech-list.astro";
import ContentDate from "@/components/content-date.astro";
import { isValidProjectCover } from "@/scripts/util";
import { ICON_SIZE } from "@/scripts/constants";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";

export const getStaticPaths = (async () => {
  const entries = await getCollection("projects");
  return entries.map(({ id }) => {
    return { params: { id } };
  });
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const project = await getEntry("projects", id)!;

const {
  data: {
    name,
    description,
    metadata: { tech, date, link, sourceHref },
    coverImage,
  },
} = project;

if (!isValidProjectCover(coverImage.data.width, coverImage.data.height)) {
  throw new Error("Cover images must have an aspect ratio of 16:10!");
}

const { Content } = await render(project);
---

<BaseLayout meta={{ kind: "projects", projectsEntry: project }}>
  <Header />

  <main>
    <div class="constrain lg:px-5">
      <ProjectCover
        projectId={id}
        coverImage={coverImage}
        class="lg:rounded-lg"
      />

      <hgroup class="px-5 lg:px-0 mt-5">
        <h1 class="text-heading font-medium text-lg/tight">{name}</h1>
        <p class="text-lg/tight text-heading">{description.short}</p>
        <p class="prose mt-3">{description.long}</p>
      </hgroup>
    </div>

    <section class="constrain px-5 mt-5">
      <h2 class="sr-only">Overview</h2>

      <dl class="prose grid grid-cols-2 *:col-span-2 *:grid *:grid-cols-subgrid *:border-t-2 *:border-dashed *:border-line">
        <div>
          <dt class="font-medium text-heading flex items-center gap-2 justify-between border-r-2 border-dashed border-line py-1 pr-3">
            Made with <WrenchIcon size={ICON_SIZE} class="stroke-icon" />
          </dt>
          <dd class="py-1 pl-3">
            <TechList tech={tech} />
          </dd>
        </div>

        <div>
          <dt class="font-medium text-heading flex items-center gap-2 justify-between border-r-2 border-dashed border-line py-1 pr-3">
            Duration <CalendarFoldIcon size={ICON_SIZE} class="stroke-icon" />
          </dt>
          <dd class="py-1 pl-3">
            <ContentDate date={date} />
          </dd>
        </div>

        {link && (
          <div>
            <dt class="font-medium text-heading flex items-center gap-2 justify-between border-r-2 border-dashed border-line py-1 pr-3">
              {link.text}{" "}
              <ExternalLinkIcon size={ICON_SIZE} class="stroke-icon" />
            </dt>
            <dd class="py-1 pl-3 relative">
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="link-primary after:absolute after:inset-0 after:z-1"
              >
                {
                  /* Get rid of https:// and only show domain */
                  link.href.slice(8).split("/")[0]
                }
              </a>
            </dd>
          </div>
        )}

        {sourceHref && (
          <div>
            <dt class="font-medium text-heading flex items-center gap-2 justify-between border-r-2 border-dashed border-line py-1 pr-3">
              Source
              <FileCodeIcon size={ICON_SIZE} class="stroke-icon" />
            </dt>
            <dd class="py-1 pl-3 relative">
              <a
                href={sourceHref}
                target="_blank"
                rel="noopener"
                class="link-primary after:absolute after:inset-0 after:z-1"
              >
                View on GitHub
              </a>
            </dd>
          </div>
        )}
      </dl>
    </section>

    <MdxContent content={Content} />
  </main>

  <Footer />
</BaseLayout>
