---
import { getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths } from "astro";

import {
  CalendarFoldIcon,
  ExternalLinkIcon,
  FileCodeIcon,
  WrenchIcon,
} from "@lucide/astro";

import BaseLayout from "@/layouts/base-layout.astro";
import MdxContent from "@/components/mdx-content.astro";
import ProjectCover from "@/components/project-cover.astro";
import TechList from "@/components/tech-list.astro";
import ContentDate from "@/components/content-date.astro";
import { isValidProjectCover } from "@/scripts/util";
import { ICON_SIZE } from "@/scripts/constants";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";

export const getStaticPaths = (async () => {
  const entries = await getCollection("projects");
  return entries.map(({ id }) => {
    return { params: { id } };
  });
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const project = await getEntry("projects", id)!;

const {
  data: {
    name,
    description,
    metadata: { tech, date, link, sourceHref },
    coverImage,
  },
} = project;

if (!isValidProjectCover(coverImage.data.width, coverImage.data.height)) {
  throw new Error("Cover images must have an aspect ratio of 16:10!");
}

let numMetadata = 2;
if (link) numMetadata += 1;
if (sourceHref) numMetadata += 1;

const { Content } = await render(project);
---

<BaseLayout meta={{ kind: "projects", projectsEntry: project }}>
  <Header />

  <main>
    <div class="constrain lg:px-5">
      <hgroup class="px-5 lg:px-0">
        <h1 class="text-heading font-medium text-xl/tight">{name}</h1>
        <p class="text-lg/tight text-heading">{description.short}</p>
        <p class="prose mt-3">{description.long}</p>
      </hgroup>

      <ProjectCover
        projectId={id}
        coverImage={coverImage}
        class="lg:rounded-lg mt-7"
      />
    </div>

    <section class="mt-7 constrain px-5">
      <h2 class="sr-only">Overview</h2>

      <dl
        class:list={[
          "grid grid-cols-1 gap-3 md:gap-y-3 max-w-(--prose-w) md:max-w-150 border-t-0 border-style pt-1.5",
          { "md:grid-cols-2": numMetadata % 2 === 0 },
          { "md:grid-cols-3": numMetadata === 3 },
        ]}
      >
        <div>
          <dt class="font-medium text-heading leading-tight flex items-center gap-2 justify-between md:justify-start">
            Made with <WrenchIcon size={ICON_SIZE} class="stroke-icon" />
          </dt>
          <dd>
            <TechList tech={tech} />
          </dd>
        </div>

        <div>
          <dt class="font-medium text-heading leading-tight flex items-center gap-2 justify-between md:justify-start">
            Duration <CalendarFoldIcon size={ICON_SIZE} class="stroke-icon" />
          </dt>
          <dd>
            <ContentDate date={date} />
          </dd>
        </div>

        {link && (
          <div>
            <dt class="font-medium text-heading leading-tight flex items-center gap-2 justify-between md:justify-start">
              {link.text}{" "}
              <ExternalLinkIcon size={ICON_SIZE} class="stroke-icon" />
            </dt>
            <dd>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="link-primary"
              >
                {
                  /* Get rid of https:// and only show domain */
                  link.href.slice(8).split("/")[0]
                }
              </a>
            </dd>
          </div>
        )}

        {sourceHref && (
          <div>
            <dt class="font-medium text-heading leading-tight flex items-center gap-2 justify-between md:justify-start">
              Source <FileCodeIcon size={ICON_SIZE} class="stroke-icon" />
            </dt>
            <dd>
              <a
                href={sourceHref}
                target="_blank"
                rel="noopener"
                class="link-primary"
              >
                View on GitHub
              </a>
            </dd>
          </div>
        )}
      </dl>
    </section>

    <MdxContent content={Content} />
  </main>

  <Footer />
</BaseLayout>
