---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import { StarIcon } from "@lucide/astro";

import { CDN_URL, ICON_SIZE } from "@/scripts/constants";
import TechList from "@/components/tech-list.astro";
import ContentDate from "@/components/content-date.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";

const featuredProjectIds = [
  "cuda-path-tracer",
  "catanks",
  "mini-minecraft",
  "door",
];

const isFeaturedProject = (id: string) => featuredProjectIds.includes(id);

const projects = await getCollection("projects");
const featured = projects.filter(({ id }) => isFeaturedProject(id));

const description =
  "Projects contain write-ups with technical details, explanations, and breakdowns of their development process.";
---

<BaseLayout meta={{ kind: "route", route: "projects", description }}>
  <Header />

  <main>
    <div class="constrain px-5">
      <h1 class="sr-only">Projects</h1>
      <p class="prose">{description}</p>
    </div>

    <section class="constrain mt-3">
      <h2 class="sr-only">Featured</h2>
      <p class="prose px-5">You should probably look at these first.</p>

      <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3 lg:w-220 desktop:px-5">
        {featured.map(({ id, data: { name, metadata } }) => (
          <li class="relative space-y-1">
            <video
              crossorigin="anonymous"
              muted
              playsinline
              loop
              autoplay
              preload="auto"
              src={`${CDN_URL}/projects/${id}/cover.mp4`}
              class="desktop:rounded-sm"
            ></video>

            <div class="flex sm:flex-col md:flex-row gap-x-4 items-center sm:items-start md:items-center justify-between sm:justify-start px-5 desktop:px-0">
              <h3>
                <a
                  href={`/projects/${id}`}
                  class="after:absolute after:inset-0 after:z-1 link-primary"
                >
                  {name}
                </a>
              </h3>

              <TechList
                tech={metadata.tech}
                class="leading-none text-link-secondary"
              />
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="constrain mt-5">
      <h2 class="sr-only">All projects</h2>
      <p class="prose px-5">
        And here's everything in list form. They're sorted by date, so the
        oldest project is at the very bottom.
      </p>

      <div class="desktop:px-5 mt-5">
        {projects.map(({ id, data: { name, blurb, metadata, cover } }) => {
          const isFeatured = isFeaturedProject(id);

          return (
            <article class="border-t-2 border-dashed border-line relative px-5 desktop:px-0 pt-2 not-last:pb-5 grid grid-cols-2 gap-x-3">
              <div class="flex gap-x-3">
                <Image
                  src={cover.img}
                  alt={cover.alt}
                  style={{ width: "9rem", height: "auto" }}
                  class="rounded-sm"
                />

                <div>
                  <h3>
                    <a
                      href={`/projects/${id}`}
                      class:list={[
                        "after:absolute after:inset-0 after:z-1 link-primary",
                        { "flex gap-1.5 items-center": isFeatured },
                      ]}
                    >
                      {name}{" "}
                      {isFeatured ?
                        <StarIcon size={0.85 * ICON_SIZE} />
                      : null}
                    </a>
                  </h3>
                  <ContentDate
                    date={metadata.date}
                    class="text-link-secondary"
                  />
                  <TechList tech={metadata.tech} class="text-link-secondary" />
                </div>
              </div>

              <p>{blurb}</p>
            </article>
          );
        })}
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
