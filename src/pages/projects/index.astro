---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

import { ArrowRightIcon } from "@lucide/astro";

import {
  DISABLED_PROJECTS,
  FEATURED_PROJECTS,
  ICON_SIZE,
} from "@/scripts/constants";
import TechList from "@/components/tech-list.astro";
import BaseLayout from "@/components/base-layout.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import VideoCover from "@/components/video-cover.astro";
import { deriveProjectTimestamp } from "@/scripts/util";

const projects = await getCollection("projects");

const featured: CollectionEntry<"projects">[] = [];
FEATURED_PROJECTS.forEach((id) => {
  const index = projects.findIndex((project) => project.id === id);
  if (index !== -1) featured.push(...projects.splice(index, 1));
});

const rest = projects
  .filter(({ id }) => !DISABLED_PROJECTS.includes(id))
  .sort(
    (a, b) =>
      deriveProjectTimestamp(b.data.meta.date) -
      deriveProjectTimestamp(a.data.meta.date),
  );

const description =
  "Projects contain write-ups with technical details, explanations, and breakdowns of their development process.";
---

<BaseLayout meta={{ kind: "route", route: "projects", description }}>
  <Header />

  <main>
    <div class="constrain px-5">
      <h1 class="sr-only">Projects</h1>
      <p class="prose">{description}</p>
    </div>

    <section class="constrain mt-3">
      <h2 class="sr-only">Featured</h2>
      <p class="prose px-5">Take a look at these first.</p>

      <div class="mt-7 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:px-5 lg:grid-cols-4">
        {featured.map(({ id, data: { name, description, coverImage } }) => (
          <article class="group relative">
            <VideoCover
              collection="projects"
              id={id}
              coverImage={coverImage}
              class="sm:rounded-sm"
            />

            <h3 class="mt-2 flex link-primary w-full items-center justify-between gap-1 px-5 desktop:justify-start sm:px-0">
              <a
                href={`/projects/${id}`}
                class="after:absolute after:inset-0 after:z-1"
              >
                {name}
              </a>
              <ArrowRightIcon size={ICON_SIZE} />
            </h3>

            <p class="px-5 sm:px-0">{description.long}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="constrain mt-7 px-5">
      <h2 id="everything-else" class="font-medium heading">
        Everything else
      </h2>
      <p class="prose">Most recent projects are listed at the top.</p>

      <div class="mt-7">
        {rest.map(({ id, data: { name, description, meta, coverImage } }) => (
          <article class="group relative flex w-fit gap-x-3 not-last:pb-3">
            <Image
              src={coverImage.file}
              alt={coverImage.alt}
              decoding="async"
              class="h-[2lh] w-auto rounded-xs bg-sweater-9 lg:h-lh light:bg-sweater-2"
            />

            <div class="flex flex-col gap-x-3 lg:flex-row">
              <h3>
                <a
                  href={`/projects/${id}`}
                  class:list={[
                    "link-primary after:absolute after:inset-0 after:z-1",
                  ]}
                >
                  {name}
                </a>
              </h3>

              <div class="flex gap-x-3">
                <p class="hidden link-secondary group-hover:text-sweater-4 sm:block sm:grid-cols-4 light:group-hover:text-sweater-7">
                  {description.short}
                </p>

                <TechList
                  tech={meta.tech}
                  class="text-sweater-6 light:text-sweater-5"
                />
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
