---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import { ArrowRightIcon, StarIcon } from "@lucide/astro";

import { CDN_URL, ICON_SIZE } from "@/scripts/constants";
import TechList from "@/components/tech-list.astro";
import ContentDate from "@/components/content-date.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";

const featuredProjectIds = ["cuda-pt", "catanks", "mini-minecraft", "door"];

const notProjectsTODO = ["deth", "dgdg", "fireball", "moore-chair"];

const isFeaturedProject = (id: string) => featuredProjectIds.includes(id);

const projects = await getCollection("projects");
const featured = projects.filter(({ id }) => isFeaturedProject(id));

const description =
  "Projects contain write-ups with technical details, explanations, and breakdowns of their development process.";
---

<BaseLayout meta={{ kind: "route", route: "projects", description }}>
  <Header />

  <main>
    <div class="constrain px-5">
      <h1 class="sr-only">Projects</h1>
      <p class="prose">{description}</p>
    </div>

    <section class="constrain mt-5">
      <h2 class="font-medium text-heading px-5">Featured</h2>
      <p class="prose px-5">You should probably look at these first.</p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:px-5">
        {featured.map(({ id, data: { name, description, metadata } }) => (
          <article class="relative flex flex-col gap-y-2">
            <video
              crossorigin="anonymous"
              muted
              playsinline
              loop
              autoplay
              preload="auto"
              src={`${CDN_URL}/projects/${id}/cover.mp4`}
              class="sm:rounded-sm"
            ></video>

            <div class="px-5 sm:px-0">
              <h3 class="flex items-center gap-1 link-primary justify-between desktop:justify-start w-full">
                <a
                  href={`/projects/${id}`}
                  class="after:absolute after:inset-0 after:z-1"
                >
                  {name}
                </a>
                <ArrowRightIcon size={ICON_SIZE} />
              </h3>
              <ContentDate
                date={metadata.date}
                class="text-link-secondary leading-none"
              />
            </div>

            <p class="px-5 sm:px-0">{description.long}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="constrain mt-7">
      <h2 class="font-medium text-heading px-5">All projects</h2>
      <p class="prose px-5">
        And here's everything in a list. They're sorted by date, so the oldest
        project is at the very bottom.
      </p>

      <div class="px-5 mt-5">
        {projects
          .filter(({ id }) => !notProjectsTODO.includes(id))
          .map(({ id, data: { name, description, metadata, cover } }) => {
            const isFeatured = isFeaturedProject(id);

            return (
              <article class="border-t-2 border-dashed border-line relative pt-2 not-last:pb-5 grid grid-cols-1 lg:grid-cols-2 gap-x-3 gap-y-2">
                <div class="flex flex-col desktop:flex-row gap-3">
                  <Image
                    src={cover.img}
                    alt={cover.alt}
                    class="rounded-sm w-auto h-[2lh]"
                  />

                  <div>
                    <h3>
                      <a
                        href={`/projects/${id}`}
                        class:list={[
                          "after:absolute after:inset-0 after:z-1 link-primary",
                          { "flex gap-1.5 items-center": isFeatured },
                        ]}
                      >
                        {name}{" "}
                        {isFeatured && <StarIcon size={0.85 * ICON_SIZE} />}
                      </a>
                    </h3>
                    <ContentDate
                      date={metadata.date}
                      class="text-link-secondary"
                    />
                    <TechList
                      tech={metadata.tech}
                      class="text-link-secondary"
                    />
                  </div>
                </div>

                <p class="max-w-(--prose-w) lg:w-auto">{description.short}</p>
              </article>
            );
          })}
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
