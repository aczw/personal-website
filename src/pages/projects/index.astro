---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import { ArrowRightIcon } from "@lucide/astro";

import { ICON_SIZE } from "@/scripts/constants";
import TechList from "@/components/tech-list.astro";
import ContentDate from "@/components/content-date.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import ProjectCover from "@/components/project-cover.astro";

const featuredProjectIds = ["cuda-pt", "catanks", "mini-minecraft", "door"];

const notProjectsTODO = ["deth", "dgdg", "fireball", "moore-chair"];

const isFeaturedProject = (id: string) => featuredProjectIds.includes(id);

const projects = await getCollection("projects");
const featured = projects.filter(({ id }) => isFeaturedProject(id));

const description =
  "Projects contain write-ups with technical details, explanations, and breakdowns of their development process.";
---

<BaseLayout meta={{ kind: "route", route: "projects", description }}>
  <Header />

  <main>
    <div class="constrain px-5">
      <h1 class="sr-only">Projects</h1>
      <p class="prose">{description}</p>
    </div>

    <section class="constrain mt-3">
      <h2 class="sr-only">Featured</h2>
      <p class="prose px-5">You should probably look at these first.</p>

      <div class="mt-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:px-5">
        {featured.map(
          ({ id, data: { name, description, metadata, coverImage } }) => (
            <article class="relative flex flex-col gap-y-2 group">
              <ProjectCover
                projectId={id}
                coverImage={coverImage}
                class="sm:rounded-sm"
              />

              <div class="px-5 sm:px-0">
                <h3 class="flex items-center gap-1 link-primary justify-between desktop:justify-start w-full">
                  <a
                    href={`/projects/${id}`}
                    class="after:absolute after:inset-0 after:z-1"
                  >
                    {name}
                  </a>
                  <ArrowRightIcon size={ICON_SIZE} />
                </h3>
                <ContentDate
                  date={metadata.date}
                  class="text-link-secondary leading-none group-hover:text-link-secondary-hover"
                />
              </div>

              <p class="px-5 sm:px-0">{description.long}</p>
            </article>
          ),
        )}
      </div>
    </section>

    <section class="constrain mt-7">
      <h2 id="everything-else" class="font-medium text-heading px-5">
        Everything else
      </h2>

      <div class="px-5 mt-3">
        {projects
          .filter(({ id }) => !notProjectsTODO.includes(id))
          .filter(({ id }) => !isFeaturedProject(id))
          .map(({ id, data: { name, description, metadata, coverImage } }) => (
            <article class="border-t-2 border-dashed border-line relative pt-2 not-last:pb-2 flex gap-x-3 group">
              <Image
                src={coverImage.data}
                alt={coverImage.alt}
                class="rounded-xs w-auto h-[2lh] lg:h-lh"
              />

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 w-full">
                <div class="flex flex-col sm:flex-row gap-x-1.5 col-span-2">
                  <h3>
                    <a
                      href={`/projects/${id}`}
                      class:list={[
                        "after:absolute after:inset-0 after:z-1 link-primary",
                      ]}
                    >
                      {name}
                    </a>
                  </h3>

                  <p class="text-link-secondary group-hover:text-link-secondary-hover">
                    {description.short}
                  </p>
                </div>

                <ContentDate date={metadata.date} class="hidden sm:block" />
                <TechList tech={metadata.tech} class="hidden sm:flex" />
              </div>
            </article>
          ))}
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
