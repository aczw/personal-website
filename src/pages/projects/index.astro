---
import { getCollection } from "astro:content";

import { ArrowRightIcon, SquareArrowRightIcon } from "@lucide/astro";

import CommonLayout from "@/layouts/common-layout.astro";
import ProjectCover from "@/components/project-cover.astro";
import { CDN_URL, DISABLED_PROJECTS, ICON_SIZE } from "@/scripts/constants";
import TechList from "@/components/tech-list.astro";
import ContentDate from "@/components/content-date.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Header from "@/components/header.astro";

const featuredProjectIds = [
  "cuda-path-tracer",
  "catanks",
  "mini-minecraft",
  "door",
];

const entries = await getCollection("projects");
const featured = entries.filter(({ id }) => featuredProjectIds.includes(id));
const projects = entries.filter(({ id }) => !featuredProjectIds.includes(id));

const description =
  "Projects contain write-ups with technical details and breakdowns of the development process.";
---

<BaseLayout meta={{ kind: "route", route: "projects", description }}>
  <Header />

  <main>
    <div class="constrain px-5">
      <h1 class="sr-only">Projects</h1>
      <p class="prose">
        {description} You should probably look at these first.
      </p>
    </div>

    <section class="constrain">
      <h2 class="sr-only">Featured</h2>

      <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3 lg:w-220 desktop:px-5">
        {featured.map(({ id, data: { name, metadata } }) => (
          <li class="relative space-y-1">
            <video
              crossorigin="anonymous"
              muted
              playsinline
              loop
              autoplay
              preload="auto"
              src={`${CDN_URL}/projects/${id}/cover.mp4`}
              class="desktop:rounded-sm"
            ></video>

            <div class="flex sm:flex-col md:flex-row gap-x-3 items-center sm:items-start md:items-center justify-between sm:justify-start px-5 desktop:px-0">
              <h3>
                <a
                  href={`/projects/${id}`}
                  class="after:absolute after:inset-0 after:z-1 link-primary"
                >
                  {name}
                </a>
              </h3>

              <TechList tech={metadata.tech} />
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section></section>
  </main>
</BaseLayout>
