---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

import { ArrowRightIcon } from "@lucide/astro";

import {
  HOMEPAGE_PROJECTS,
  ICON_SIZE,
  VALID_MONTHS,
} from "@/scripts/constants";
import TechList from "@/components/tech-list.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import ProjectCover from "@/components/project-cover.astro";
import type { ContentDate } from "@/scripts/types";
import { getDateKind } from "@/scripts/util";

const featuredProjectIds = [...HOMEPAGE_PROJECTS, "door"];

const projects = await getCollection("projects");

const featured: CollectionEntry<"projects">[] = [];
featuredProjectIds.forEach((id) => {
  const index = projects.findIndex((project) => project.id === id);
  if (index !== -1) featured.push(...projects.splice(index, 1));
});

const toUnixTimestamp = (dateString: string): number => {
  const [month, year] = dateString.split(" ");
  const monthIdx = VALID_MONTHS.indexOf(month!);

  if (monthIdx === -1) throw new Error(`Invalid month: ${month}`);

  return Date.UTC(Number(year), monthIdx, 1) * 0.001;
};

const deriveTimestamp = (date: ContentDate): number => {
  const dateKind = getDateKind(date);

  if (dateKind.kind === "simple") {
    return toUnixTimestamp(dateKind.date);
  } else {
    return toUnixTimestamp(dateKind.date.to);
  }
};

const rest = projects.sort(
  (a, b) =>
    deriveTimestamp(b.data.metadata.date) -
    deriveTimestamp(a.data.metadata.date),
);

const description =
  "Projects contain write-ups with technical details, explanations, and breakdowns of their development process.";
---

<BaseLayout meta={{ kind: "route", route: "projects", description }}>
  <Header />

  <main>
    <div class="constrain px-5">
      <h1 class="sr-only">Projects</h1>
      <p class="prose">{description}</p>
    </div>

    <section class="constrain mt-3">
      <h2 class="sr-only">Featured</h2>
      <p class="prose px-5">Take a look at these first.</p>

      <div class="mt-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:px-5">
        {featured.map(({ id, data: { name, description, coverImage } }) => (
          <article class="relative group">
            <ProjectCover
              projectId={id}
              coverImage={coverImage}
              class="sm:rounded-sm"
            />

            <h3 class="flex mt-2 items-center gap-1 link-primary justify-between desktop:justify-start w-full px-5 sm:px-0">
              <a
                href={`/projects/${id}`}
                class="after:absolute after:inset-0 after:z-1"
              >
                {name}
              </a>
              <ArrowRightIcon size={ICON_SIZE} />
            </h3>

            <p class="sm:px-0 px-5">{description.long}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="constrain mt-7">
      <h2 id="everything-else" class="font-medium text-heading px-5">
        Everything else
      </h2>
      <p class="prose px-5">Most recent projects are listed at the top.</p>

      <div class="px-5 mt-7">
        {rest.map(
          ({ id, data: { name, description, metadata, coverImage } }) => (
            <article class="relative w-fit not-last:pb-3 flex gap-x-3 group">
              <Image
                src={coverImage.data}
                alt={coverImage.alt}
                class="rounded-xs w-auto h-[2lh] lg:h-lh bg-sweater-9 light:bg-sweater-2"
              />

              <div class="flex gap-x-3 flex-col lg:flex-row">
                <h3>
                  <a
                    href={`/projects/${id}`}
                    class:list={[
                      "after:absolute after:inset-0 after:z-1 link-primary",
                    ]}
                  >
                    {name}
                  </a>
                </h3>

                <div class="flex gap-x-3">
                  <p class="hidden sm:block text-link-secondary group-hover:text-link-secondary-hover">
                    {description.short}
                  </p>

                  <TechList
                    tech={metadata.tech}
                    class="text-sweater-6 light:text-sweater-5"
                  />
                </div>
              </div>
            </article>
          ),
        )}
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
