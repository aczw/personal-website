---
import type { GetStaticPaths } from "astro";
import { render, getEntry, getCollection } from "astro:content";

import { ArrowLeftIcon } from "@lucide/astro";

import BaseLayout from "@/components/base-layout.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import MdxContent from "@/components/mdx-content.astro";
import { ICON_SIZE } from "@/scripts/constants";

export const getStaticPaths = (async () => {
  const projectPages = await getCollection("projectPages");
  return projectPages.map((entry) => {
    const parts = entry.id.split("/");
    return { params: { id: parts[0]!, page: parts[1]! }, props: { entry } };
  });
}) satisfies GetStaticPaths;

const { id: projectId } = Astro.params;
const { entry } = Astro.props;

const project = await getEntry("projects", projectId)!;
const { Content } = await render(entry);
---

<BaseLayout meta={{ kind: "projectPages", projectPagesEntry: entry }}>
  <Header />

  <main>
    <section class="constrain px-5">
      <hgroup class="flex gap-x-1.5 text-xl/tight font-medium heading">
        <p>{project.data.name} /</p>
        <h1>{entry.data.title}</h1>
      </hgroup>

      <a
        href={`/projects/${projectId}`}
        class="mt-5 flex link-primary w-fit items-center gap-1.5"
      >
        <ArrowLeftIcon size={ICON_SIZE} /> Back to {project.data.name}
      </a>

      <p class="mt-5 prose">{entry.data.description}</p>
    </section>

    <MdxContent content={Content} />
  </main>

  <Footer />
</BaseLayout>
