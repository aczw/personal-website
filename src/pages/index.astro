---
import { getEntries } from "astro:content";
import { Image } from "astro:assets";

import { ArrowRightIcon } from "@lucide/astro";

import Eye from "@/components/eye.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { HOMEPAGE_PROJECTS } from "@/scripts/constants";
import RecentTracks from "@/components/homepage/recent-tracks.astro";
import TopStats from "@/components/homepage/top-stats.astro";

const projects = await getEntries(
  HOMEPAGE_PROJECTS.map((id) => {
    return { collection: "projects", id };
  }),
);
---

<BaseLayout meta={{ kind: "route", route: "home", description: "NEW" }}>
  <header class="constrain px-5 mt-6 sm:mt-20">
    <nav class="sm:w-(--prose-w)">
      <a
        href="/"
        title="Home"
        aria-label="Go to the homepage"
        class="group flex w-fit items-center gap-1.5"
      >
        <Eye
          size={3.5}
          class="fill-sweater-5 group-hover:fill-sweater-4 light:fill-sweater-6 light:group-hover:fill-sweater-7"
        />
        <span class="text-lg/1 leading-none font-medium text-sweater-5 group-hover:text-sweater-4 light:text-sweater-6 light:group-hover:text-sweater-7">
          Charles Wang
        </span>
      </a>

      <div class="mt-4 flex gap-4 border-t-2 border-dashed border-line pt-0.5 *:link-primary">
        <a href="/index">Index</a>
        <a href="/projects">Projects</a>
        <a href="/posts">Writing</a>
        <a href="/about">About</a>
      </div>
    </nav>
  </header>

  <main class="mt-4 overflow-x-hidden">
    <div class="constrain px-5 space-y-3 *:sm:w-(--prose-w)">
      <p>
        Hi, welcome. Thanks for visiting my little space. I wonder how you ended
        up here? Please do take a look around and explore.
      </p>
      <p>Here are some projects I've worked on...</p>
    </div>

    <section
      class="constrain desktop:px-5 mt-5 space-y-1 grid grid-cols-1 md:grid-cols-3 gap-3"
      aria-label="Some projects I made"
    >
      {projects.map(({ id, data: { subtitle, cover } }, index) => (
        <article class="relative space-y-1 group">
          <Image
            id={`cover-image-${index}`}
            src={cover.img}
            alt={cover.alt}
            class="aspect-16/10 w-full h-auto desktop:rounded-lg bg-sweater-9 light:bg-sweater-2 hidden"
            loading="lazy"
            decoding="async"
          />
          <canvas
            id={`tile-${index}`}
            class="aspect-16/10 w-full desktop:rounded-lg bg-sweater-9 light:bg-sweater-2"
            aria-hidden="true"
          />
          <h2 class="px-5 desktop:px-0">
            <a
              href={`/projects/${id}`}
              class="after:absolute flex items-center justify-between desktop:justify-start gap-1 after:inset-0 after:z-1 group-hover:text-link-primary-hover link-primary"
            >
              {subtitle ? subtitle : "<NO SUBTITLE>"}
              <ArrowRightIcon size={16} />
            </a>
          </h2>
        </article>
      ))}
    </section>

    <section class="mt-5 constrain">
      <p class="sm:w-(--prose-w) px-5">
        Music is how I pass the time. More often than not I am listening to
        something. Each of my playlists mean so much to me.
      </p>

      <div class="flex flex-col lg:flex-row gap-x-6 gap-y-5 mt-3">
        <div class="md:w-(--prose-w) desktop:px-5 md:pr-0">
          <TopStats server:defer>
            <Fragment slot="fallback">
              <div
                aria-hidden="true"
                class="px-5 desktop:px-0 mb-5 bg-sweater-9 light:bg-sweater-2 desktop:rounded-sm animate-pulse h-lh"
              ></div>

              <div
                aria-hidden="true"
                class="animate-pulse grid grid-cols-4 desktop:gap-3 *:bg-sweater-9 *:light:bg-sweater-2 *:desktop:rounded-sm *:aspect-square *:w-full *:h-auto"
              >
                {Array.from({ length: 8 }).map(() => (
                  <div></div>
                ))}
              </div>
            </Fragment>
          </TopStats>
        </div>

        <div class="grow flex flex-col gap-y-5 pr-5 pl-5 lg:pl-0">
          <p>Recently I've been listening to...</p>

          <RecentTracks server:defer>
            <div
              aria-hidden="true"
              class="animate-pulse flex flex-col gap-3 grow justify-between *:flex *:gap-x-3"
              slot="fallback"
            >
              {Array.from({ length: 3 }).map(() => (
                <div class="*:rounded-sm *:bg-sweater-9 *:light:bg-sweater-2">
                  <div class="size-[3.25lh]"></div>
                  <div class="grow"></div>
                </div>
              ))}
            </div>
          </RecentTracks>
        </div>
      </div>
    </section>

    <section class="my-5 constrain px-5">
      <p>
        I currently live in Los Angeles, where it's{" "}
        <span id="time-hour">12</span>
        <span id="time-colon" style={{ opacity: 1 }}>
          :
        </span>
        <span id="time-minutes">00</span> <span id="time-period">AM</span>. Come
        find me!
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import { CURRENT_TIMEZONE } from "@/scripts/constants";

  const hourElt = document.getElementById("time-hour") as HTMLSpanElement;
  const colonElt = document.getElementById("time-colon") as HTMLSpanElement;
  const minsElt = document.getElementById("time-minutes") as HTMLSpanElement;
  const periodElt = document.getElementById("time-period") as HTMLSpanElement;

  const formatter = new Intl.DateTimeFormat("en-US", {
    hour: "numeric",
    minute: "2-digit",
    hour12: true,
    timeZone: CURRENT_TIMEZONE,
  });

  const tick = () => {
    colonElt.style.opacity = colonElt.style.opacity === "1" ? "0" : "1";

    const now = Date.now();

    const parts = formatter.formatToParts(now);
    hourElt.textContent = parts.find((part) => part.type === "hour")!.value;
    minsElt.textContent = parts.find((part) => part.type === "minute")!.value;
    periodElt.textContent = parts.find(
      (part) => part.type === "dayPeriod",
    )!.value;

    const fractMs = now % 1000;
    const delay = 1000 - fractMs;

    window.setTimeout(tick, delay);
  };

  tick();
</script>

<script>
  import { HOMEPAGE_PROJECTS } from "@/scripts/constants";
  import { initializeGfx } from "@/scripts/homepage/gfx";
  import {
    checkToAdvanceState,
    createTile,
    getUniformsForState,
  } from "@/scripts/homepage/tile";

  const displayCoverImages = () =>
    HOMEPAGE_PROJECTS.forEach((_, index) => {
      const tileCanvasElt = document.getElementById(
        `tile-${index}`,
      ) as HTMLCanvasElement;
      const coverImageElt = document.getElementById(
        `cover-image-${index}`,
      ) as HTMLImageElement;

      tileCanvasElt.remove();
      coverImageElt.classList.remove("hidden");
    });

  const run = () => {
    const gfxRes = initializeGfx();

    if (gfxRes.kind === "err") {
      console.error(`Error initializing graphics context: ${gfxRes.message}`);
      displayCoverImages();
      return;
    }

    const { offCanvas, gl, program } = gfxRes.data;

    const tileResArr = HOMEPAGE_PROJECTS.map((projectId, index) =>
      createTile(gl, projectId, index),
    );

    if (
      !tileResArr.every((tileRes, index) => {
        if (tileRes.kind === "err")
          console.error(`Failed to create tile ${index}: ${tileRes.message}`);

        return tileRes.kind === "ok";
      })
    ) {
      console.error("Failed to create all 3 tiles");
      displayCoverImages();
      return;
    }

    const tiles = tileResArr.map((tileRes) => tileRes.data);

    gl.uniform1i(gl.getUniformLocation(program, "u_video_frame"), 0);

    const dimensionsUnif = gl.getUniformLocation(program, "u_dimensions");
    const timeUnif = gl.getUniformLocation(program, "u_time");
    const colorAUnif = gl.getUniformLocation(program, "u_color_a");
    const colorBUnif = gl.getUniformLocation(program, "u_color_b");

    const biasUnif = gl.getUniformLocation(program, "u_bias");
    const mixUnif = gl.getUniformLocation(program, "u_mix");
    const ditherSizeUnif = gl.getUniformLocation(program, "u_dither_size");

    const directionUnif = gl.getUniformLocation(program, "u_direction");
    const offsetUnif = gl.getUniformLocation(program, "u_offset");

    const toggleColorScheme = (prefersDark: boolean) => {
      if (prefersDark) {
        gl.uniform3f(colorAUnif, 0.11372, 0.09803, 0.23921); // sweater-7
        gl.uniform3f(colorBUnif, 0.28235, 0.26274, 0.5647); // sweater-9
      } else {
        gl.uniform3f(colorAUnif, 0.83921, 0.82745, 1.0); // sweater-4
        gl.uniform3f(colorBUnif, 0.67843, 0.65098, 1.0); // sweater-2
      }
    };

    const prefersDarkQuery = window.matchMedia("(prefers-color-scheme: dark)");
    prefersDarkQuery.addEventListener("change", (ev) =>
      toggleColorScheme(ev.matches),
    );
    toggleColorScheme(prefersDarkQuery.matches);

    // The timestamp at which the draw loop actually begins running, which
    // will likely be lagging behind page load
    const drawStartTime = performance.now() * 0.001;

    const draw: FrameRequestCallback = (now) => {
      const elapsed = Math.max(now * 0.001 - drawStartTime, 0);

      gl.uniform1f(timeUnif, elapsed);

      tiles.forEach((tile) => {
        const { canvasElt, proc } = tile;

        // https://webgl2fundamentals.org/webgl/lessons/webgl-resizing-the-canvas.html
        if (
          offCanvas.width !== canvasElt.clientWidth ||
          offCanvas.height !== canvasElt.clientHeight
        ) {
          offCanvas.width = canvasElt.clientWidth;
          offCanvas.height = canvasElt.clientHeight;

          gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);
          gl.uniform2i(dimensionsUnif, gl.canvas.width, gl.canvas.height);
        }

        // Mutates tile state in place
        checkToAdvanceState(gl, tile, elapsed);
        const { bias, mix, ditherSize } = getUniformsForState(
          tile.state,
          elapsed,
        );

        gl.uniform1f(biasUnif, bias);
        gl.uniform1f(mixUnif, mix);
        gl.uniform1i(ditherSizeUnif, ditherSize);
        gl.uniform2f(directionUnif, proc.direction.x, proc.direction.y);
        gl.uniform2f(offsetUnif, proc.offset.u, proc.offset.v);

        gl.clearColor(0.0, 0.0, 0.0, 0.0);
        gl.bindTexture(gl.TEXTURE_2D, tile.video.frameTex);
        gl.drawArrays(gl.TRIANGLES, 0, 3);

        tile.bitmapCtx.transferFromImageBitmap(
          offCanvas.transferToImageBitmap(),
        );
      });

      requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);
  };

  run();
</script>
