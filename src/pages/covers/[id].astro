---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";

import {
  ArrowLeftIcon,
  CalendarClockIcon,
  CircleArrowDownIcon,
  ImageIcon,
  WrenchIcon,
} from "@lucide/astro";

import BaseLayout from "@/components/base-layout.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import { ICON_SIZE } from "@/scripts/constants";
import TechList from "@/components/tech-list.astro";
import { getFullDateFormatting, getShortDateFormatting } from "@/scripts/util";
import MdxContent from "@/components/mdx-content.astro";

export const getStaticPaths = (async () => {
  const coverArt = await getCollection("covers");
  return coverArt.map((cover) => {
    return { params: { id: cover.id } };
  });
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const cover = await getEntry("covers", id)!;

const { title, artists, image, meta } = cover.data;

const downloadFileName = `${id}.${image.file.format}`;

const { Content } = await render(cover);
---

<BaseLayout meta={{ kind: "covers", coversEntry: cover }}>
  <Header />

  <main>
    <hgroup class="constrain px-5">
      <h1 class="mt-3 prose text-xl/tight font-medium heading">{title}</h1>
      <p class="prose text-lg/tight heading">by {artists.join(", ")}</p>

      <p class="mt-5">
        <a href="/covers" class="flex link-primary w-fit items-center gap-1.5">
          <ArrowLeftIcon size={ICON_SIZE} /> Back to all cover art
        </a>
      </p>
    </hgroup>

    <section class="constrain mt-7">
      <h2 class="sr-only">Artwork</h2>

      <div class="md:px-5">
        <Image
          src={image.file}
          alt={image.alt}
          class="h-auto w-full max-w-(--wide-w) md:rounded-sm"
        />
      </div>
    </section>

    <section class="constrain mt-7 px-5">
      <h2 class="sr-only">Overview</h2>

      <dl class="grid max-w-(--prose-w) grid-cols-1 gap-3 md:max-w-150 md:grid-cols-2">
        <div>
          <dt class="flex items-center justify-between gap-2 leading-tight font-medium heading md:justify-start">
            Resolution <ImageIcon size={ICON_SIZE} class="icon" />
          </dt>
          <dd>
            {image.file.width}×{image.file.height}
          </dd>
        </div>

        <div>
          <dt class="flex items-center justify-between gap-2 leading-tight font-medium heading md:justify-start">
            Download file <CircleArrowDownIcon size={ICON_SIZE} class="icon" />
          </dt>
          <dd>
            <a
              href={image.file.src}
              download={downloadFileName}
              class="link-primary"
            >
              {downloadFileName}
            </a>
          </dd>
        </div>

        <div>
          <dt class="flex items-center justify-between gap-2 leading-tight font-medium heading md:justify-start">
            Tools <WrenchIcon size={ICON_SIZE} class="icon" />
          </dt>
          <dd>
            <TechList tech={meta.tools} />
          </dd>
        </div>

        <div>
          <dt class="flex items-center justify-between gap-2 leading-tight font-medium heading md:justify-start">
            Created <CalendarClockIcon size={ICON_SIZE} class="icon" />
          </dt>
          <dd>
            <time
              title={getFullDateFormatting(meta.created)}
              datetime={meta.created.toISOString()}
            >
              {getShortDateFormatting(meta.created)}
            </time>
          </dd>
        </div>
      </dl>
    </section>

    <MdxContent content={Content} />
  </main>

  <Footer />
</BaseLayout>
