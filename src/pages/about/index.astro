---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import mooreJpg from "@/assets/about/moore.jpg";
import painesParkJpg from "@/assets/about/paines-park.jpg";
import s12thAndPanamaJpg from "@/assets/about/s-12th-panama.jpg";
import stitelerJpg from "@/assets/about/stiteler.jpg";
import schuylkillJpg from "@/assets/about/schuylkill.jpg";

import pizzaJpg from "@/assets/about/pizza.jpg";

import busanJpg from "@/assets/about/busan.jpg";
import tokyoJpg from "@/assets/about/tokyo.jpg";
import zhangjiajieJpg from "@/assets/about/zhangjiajie.jpg";

import BaseLayout from "@/components/base-layout.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";

type ImageCarouselItem = {
  file: ImageMetadata;
  alt: string;
  caption: string;
};

const philly: ImageCarouselItem[] = [
  {
    file: mooreJpg,
    alt: "The Moore School Building is covered by a tree with white flowers in the foreground",
    caption: "Moore School Building",
  },
  {
    file: painesParkJpg,
    alt: "A concrete pillar in a skate park with CGGT graffiti in orange",
    caption: "Paine's Park",
  },
  {
    file: s12thAndPanamaJpg,
    alt: "An alley with an old-fashioned stone brick road surrounded by brick buildings",
    caption: "S 12th St & Panama St",
  },
  {
    file: stitelerJpg,
    alt: "Underground tunnel littered with wooden pallets on the ground",
    caption: "Underneath Stiteler Hall",
  },
  {
    file: schuylkillJpg,
    alt: "Platform above the Schuylkill River with buildings in the background",
    caption: "Schuylkill River trail",
  },
];

const asiaTrip: ImageCarouselItem[] = [
  {
    file: busanJpg,
    alt: "Utility wires and rooftops",
    caption: "Gamcheon-dong, Busan, South Korea",
  },
  {
    file: tokyoJpg,
    alt: "Koi fish pond",
    caption: "Asakusa, Tokyo, Japan",
  },
  {
    file: zhangjiajieJpg,
    alt: "Tons of red ribbons attached to a railing overlooking mountains",
    caption: "Zhangjiajie, Hunan, China",
  },
];

const description = "Writing about myself is very hard but here it is.";
---

<BaseLayout
  meta={{
    kind: "route",
    route: "about",
    description,
  }}
>
  <Header />

  <main>
    <h1 class="sr-only">About</h1>

    <section class="constrain *:px-5">
      <h2 class="sr-only">General</h2>
      <p class="prose">{description}</p>
      <p class="mt-3 prose">
        I recently graduated from Penn with a major in Digital Media Design. At
        school I co-led the game dev club{" "}
        <a
          href="https://pennupgrade.com"
          target="_blank"
          rel="noopener"
          class="link-primary"
        >
          UPGRADE
        </a>{" "}
        and served on the{" "}
        <a
          href="https://cg.cis.upenn.edu"
          target="_blank"
          rel="noopener"
          class="link-primary"
        >
          CG@Penn
        </a>{" "}
        student board. I am infinitely grateful to that community.
      </p>

      <div class="mt-7 flex gap-x-3 overflow-x-auto">
        {philly.map(({ file, alt, caption }) => (
          <figure class="shrink-0">
            <Image src={file} alt={alt} class="h-[12lh] w-auto rounded-sm" />
            <figcaption class="mt-1 text-sm heading">{caption}</figcaption>
          </figure>
        ))}
      </div>

      <p class="mt-5 prose">
        Currently I work at{" "}
        <a
          href="https://specs.com"
          target="_blank"
          rel="noopener"
          class="link-primary"
        >
          SPECS
        </a>{" "}
        where I'm helping to build out our AR development platform. More
        specifically I'm working on our engine runtime and editor which has been
        immensely fun.
      </p>
    </section>

    <section class="constrain mt-7 px-5 *:prose">
      <h2 id="fun-facts" class="font-medium heading">
        Fun facts you should know
      </h2>
      <p>
        Growing up, my family owned a sofa that smelled like the Titanic to me.
        I lived in Germany for 5 years. No, I can't speak German anymore.
      </p>

      <figure class="mt-7">
        <Image
          src={pizzaJpg}
          alt="Younger me biting pizza that someone is giving me"
          class="rounded-sm"
        />
        <figcaption class="mt-1 text-sm heading">
          Eating whatever is in front of me
        </figcaption>
      </figure>

      <p class="mt-5">
        My lucky number is 13. It follows me around everywhere. I only enjoy
        coconuts inside Almond Joys. I love onions and onion rings.
      </p>
    </section>

    <section class="constrain mt-7">
      <div class="px-5 *:prose">
        <hgroup class="flex gap-x-2">
          <h2 id="now" class="font-medium heading">
            Now
          </h2>
          <p class="text-sweater-5 light:text-sweater-6">October 2026</p>
        </hgroup>
        <p>
          Adjusting to the post-grad life, West Coast, and newfound free time.
        </p>
        <p class="mt-3">
          I've been thinking about buying a bike for the work commute. Everyone
          is telling me this is a bad idea.
        </p>
        <p class="mt-3">
          I recently went on a 3-month Asia trip. Here's some pictures...
        </p>
      </div>

      <div class="mt-7 flex gap-x-3 overflow-x-auto px-5">
        {asiaTrip.map(({ file, alt, caption }) => (
          <figure class="shrink-0">
            <Image src={file} alt={alt} class="h-[16lh] w-auto rounded-sm" />
            <figcaption class="mt-1 text-sm heading">{caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="constrain mt-7 px-5">
      <h2 id="this-website" class="font-medium heading">
        This website
      </h2>
      <p class="prose">
        For more information please visit the{" "}
        <a href="/colophon" class="link-primary">
          colophon
        </a>
        .
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
