---
import { Image } from "astro:assets";

import seoulJpg from "@/assets/about/seoul.jpg";
import tokyoJpg from "@/assets/about/tokyo.jpg";
import zhangjiajieJpg from "@/assets/about/zhangjiajie.jpg";

import BaseLayout from "@/components/base-layout.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";

const description = "Writing about myself is very hard but here it is.";
---

<BaseLayout
  meta={{
    kind: "route",
    route: "about",
    description,
  }}
>
  <Header />

  <main>
    <h1 class="sr-only">About</h1>

    <section class="constrain space-y-3 px-5 *:prose">
      <h2 class="sr-only">General</h2>
      <p>{description}</p>
      <p>
        I recently graduated from Penn with a major in Digital Media Design. At
        school I co-led the game dev club{" "}
        <a
          href="https://pennupgrade.com"
          target="_blank"
          rel="noopener"
          class="link-primary"
        >
          UPGRADE
        </a>{" "}
        and served on the{" "}
        <a
          href="https://cg.cis.upenn.edu"
          target="_blank"
          rel="noopener"
          class="link-primary"
        >
          CG@Penn
        </a>{" "}
        student board. I am infinitely grateful to that community.
      </p>
      <p>
        Currently I work at{" "}
        <a
          href="https://specs.com"
          target="_blank"
          rel="noopener"
          class="link-primary"
        >
          SPECS
        </a>{" "}
        where I'm helping to build out our AR development platform. More
        specifically I'm working on our engine runtime and editor which has been
        immensely fun.
      </p>
      <p>I would put a picture of myself here but I'm too shy.</p>
    </section>

    <section class="constrain mt-7">
      <div class="px-5">
        <hgroup class="flex gap-x-2">
          <h2 id="now" class="font-medium heading">
            Now
          </h2>
          <p class="text-sweater-6">October 2026</p>
        </hgroup>

        <p class="prose">
          Adjusting to the post-grad life, West Coast, and newfound free time. I
          recently went on a 3-month Asia trip. Here's some pictures...
        </p>
      </div>

      <div class="mt-7 flex gap-x-3 overflow-x-auto px-5">
        <figure class="shrink-0">
          <Image src={seoulJpg} alt="" class="h-[15lh] w-auto rounded-sm" />
          <figcaption class="mt-1 text-sm heading">
            Seoul, South Korea
          </figcaption>
        </figure>

        <figure class="shrink-0">
          <Image src={tokyoJpg} alt="" class="h-[15lh] w-auto rounded-sm" />
          <figcaption class="mt-1 text-sm heading">Tokyo, Japan</figcaption>
        </figure>

        <figure class="shrink-0">
          <Image
            src={zhangjiajieJpg}
            alt=""
            class="h-[15lh] w-auto rounded-sm"
          />
          <figcaption class="mt-1 text-sm heading">
            Zhangjiajie, China
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="constrain mt-7 px-5">
      <h2 id="this-website" class="font-medium heading">
        This website
      </h2>
      <p class="prose">
        For more information about the site itself please visit the{" "}
        <a href="/colophon" class="link-primary">
          colophon
        </a>{" "}
        page.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
