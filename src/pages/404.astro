---
import BaseLayout from "@/layouts/base-layout.astro";
import Header from "@/components/header.astro";

const description =
  "Sorry, this page does not exist. How did you end up here??";
---

<BaseLayout
  meta={{
    kind: "route",
    route: "404",
    description,
  }}
>
  <Header />

  <main>
    <hgroup class="constrain px-5">
      <h1 class="font-medium text-heading">Page not found</h1>
      <p>{description}</p>
    </hgroup>
  </main>
</BaseLayout>
