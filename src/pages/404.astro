---
import BaseLayout from "@/components/base-layout.astro";
import Header from "@/components/header.astro";

const description = "Sorry, this page does not exist. How did this happen?";
---

<BaseLayout
  meta={{
    kind: "route",
    route: "404",
    description,
  }}
>
  <Header id="header" />

  <main>
    <hgroup id="content" class="constrain px-5">
      <h1 class="sr-only">Page not found</h1>
      <p class="prose">
        {description} Oh well. Since you're here now anyway, you might as well{" "}
        <button id="open-pane" class="inline link-primary">
          play with the background
        </button>
        .
      </p>
    </hgroup>

    <canvas
      id="noise"
      class="absolute inset-0 -z-1 h-full w-full bg-sweater-10 light:bg-sweater-1"
    ></canvas>

    <div class="absolute inset-x-5 bottom-5">
      <div id="pane-container" class="mx-auto w-full desktop:max-w-100"></div>
    </div>
  </main>
</BaseLayout>

<script>
  import vertSrc from "@/shaders/quad.vert.glsl?raw";
  import fragSrc from "@/shaders/noise.frag.glsl?raw";

  import { Pane } from "tweakpane";
  import * as TpEssentialsPlugin from "@tweakpane/plugin-essentials";
  import type { FpsGraphBladeApi } from "@tweakpane/plugin-essentials";

  import {
    CANVAS_HEIGHT,
    CANVAS_WIDTH,
    checkForResize,
    initializeGfx,
  } from "@/scripts/gfx";
  import { setColorScheme } from "@/scripts/noise";
  import { commitStyleAnimation, lerp } from "@/scripts/util";
  import { KEYFRAME_ANIM_OPTS } from "@/scripts/constants";

  const run = () => {
    const gfxRes = initializeGfx(vertSrc, fragSrc);

    if (gfxRes.kind === "err") {
      console.error(`Error initializing graphics context: ${gfxRes.message}`);
      return;
    }

    const { offCanvas, gl, program } = gfxRes.data;

    const canvasElt = document.getElementById("noise") as HTMLCanvasElement;
    const bitmapCtx = canvasElt.getContext("bitmaprenderer");

    if (!bitmapCtx) {
      console.error("Failed to create bitmap rendering context");
      return;
    }

    const dimensionsUnif = gl.getUniformLocation(program, "u_dimensions");
    const timeUnif = gl.getUniformLocation(program, "u_time");
    const colorAUnif = gl.getUniformLocation(program, "u_color_a");
    const colorBUnif = gl.getUniformLocation(program, "u_color_b");

    const biasUnif = gl.getUniformLocation(program, "u_bias");
    const ditherSizeUnif = gl.getUniformLocation(program, "u_dither_size");

    const directionUnif = gl.getUniformLocation(program, "u_direction");
    const offsetUnif = gl.getUniformLocation(program, "u_offset");

    setColorScheme(gl, {
      a: {
        location: colorAUnif,
        light: { r: 0.7647, g: 0.74117, b: 1.0 }, // sweater-3
        dark: { r: 0.11372, g: 0.09803, b: 0.23921 }, // sweater-9
      },
      b: {
        location: colorBUnif,
        light: { r: 0.88235, g: 0.8745, b: 1.0 }, // sweater-1
        dark: { r: 0.03921, g: 0.03529, b: 0.09803 }, // sweater-10
      },
    });
    gl.uniform1i(ditherSizeUnif, 7);
    gl.uniform2f(directionUnif, 1, 1);
    gl.uniform2f(offsetUnif, 0.0, 0.0);

    document.getElementById("open-pane")!.addEventListener("click", () => {
      const headerElt = document.getElementById("header")!;
      const contentElt = document.getElementById("content")!;

      headerElt
        .animate([{ opacity: 0 }], KEYFRAME_ANIM_OPTS)
        .addEventListener("finish", (ev) => {
          commitStyleAnimation(ev);
          headerElt.style.display = "none";
        });
      contentElt
        .animate([{ opacity: 0 }], KEYFRAME_ANIM_OPTS)
        .addEventListener("finish", (ev) => {
          commitStyleAnimation(ev);
          contentElt.style.display = "none";
        });
    });

    const params = {
      dimensions: `${CANVAS_WIDTH}×${CANVAS_HEIGHT}`,
      backend: "WebGL 2",
    };

    const pane = new Pane({
      container: document.getElementById("pane-container")!,
    });
    pane.registerPlugin(TpEssentialsPlugin);

    const drawBlade = pane.addBlade({
      view: "fpsgraph",
      label: "FPS",
      min: 0,
      max: 120,
      rows: 1.5,
    }) as FpsGraphBladeApi;
    drawBlade.on("tick", (ev) => {
      // Dynamically adjust FPS max bound
      if (ev.target.fps && ev.target.fps > ev.target.max) {
        ev.target.max = ev.target.fps + 15;
      }
    });

    pane.addBinding(params, "dimensions", {
      readonly: true,
      label: "Dimensions",
    });
    pane.addBinding(params, "backend", {
      readonly: true,
      label: "Backend",
    });

    const draw: FrameRequestCallback = (now) => {
      drawBlade.begin();
      const elapsed = now * 0.001;

      gl.uniform1f(timeUnif, elapsed);
      checkForResize(gl, offCanvas, canvasElt, dimensionsUnif);
      params.dimensions = `${gl.canvas.width}×${gl.canvas.height}`;
      const t = Math.min(elapsed / 5, 1);
      gl.uniform1f(biasUnif, lerp(0.0, -1.0, Math.pow(1 - t, 5)));

      gl.clearColor(0.0, 0.0, 0.0, 0.0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      bitmapCtx.transferFromImageBitmap(offCanvas.transferToImageBitmap());

      drawBlade.end();
      requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);
  };

  run();
</script>

<style>
  main {
    /* Force Tweakpane to use my Maple Mono settings */
    #pane-container {
      font-feature-settings: var(--font-mono--font-feature-settings);

      /* Make Tweakpane use Maple Mono */
      --tp-base-font-family: var(--font-mono);
    }
  }
</style>
