---
import BaseLayout from "@/components/base-layout.astro";
import Header from "@/components/header.astro";

const description = "Sorry, this page does not exist. How did this happen?";
---

<BaseLayout
  meta={{
    kind: "route",
    route: "404",
    description,
  }}
>
  <Header id="header" />

  <main>
    <hgroup id="content" class="constrain px-5">
      <h1 class="sr-only">Page not found</h1>
      <p class="prose">
        {description} Oh well. Since you're here now anyway, you might as well{" "}
        <button
          id="open-pane"
          class="inline link-primary rounded-sm bg-sweater-9 px-1.25 hover:bg-sweater-8 light:bg-sweater-2 light:hover:bg-sweater-3"
          data-init="false"
          data-show="true"
        >
          play with the background
        </button>
        .
      </p>
    </hgroup>

    <canvas
      id="noise"
      class="absolute inset-0 -z-1 h-full w-full bg-sweater-10 light:bg-sweater-1"
    ></canvas>

    <div class="absolute inset-x-5 bottom-5">
      <div id="pane-container" class="mx-auto w-full desktop:max-w-100"></div>
    </div>
  </main>
</BaseLayout>

<script>
  import vertSrc from "@/shaders/quad.vert.glsl?raw";
  import fragSrc from "@/shaders/noise.frag.glsl?raw";

  import { Pane } from "tweakpane";
  import * as TpEssentialsPlugin from "@tweakpane/plugin-essentials";
  import type { FpsGraphBladeApi } from "@tweakpane/plugin-essentials";

  import {
    CANVAS_HEIGHT,
    CANVAS_WIDTH,
    checkForResize,
    initializeGfx,
  } from "@/scripts/gfx";
  import { SWEATER_1, SWEATER_10, SWEATER_3, SWEATER_9 } from "@/scripts/noise";
  import { commitStyleAnimation, lerp } from "@/scripts/util";
  import { KEYFRAME_ANIM_OPTS } from "@/scripts/constants";

  const run = () => {
    const gfxRes = initializeGfx(vertSrc, fragSrc);

    if (gfxRes.kind === "err") {
      console.error(`Error initializing graphics context: ${gfxRes.message}`);
      return;
    }

    const { offCanvas, gl, program } = gfxRes.data;

    const canvasElt = document.getElementById("noise") as HTMLCanvasElement;
    const bitmapCtx = canvasElt.getContext("bitmaprenderer");

    if (!bitmapCtx) {
      console.error("Failed to create bitmap rendering context");
      return;
    }

    const dimensionsUnif = gl.getUniformLocation(program, "u_dimensions");
    const timeUnif = gl.getUniformLocation(program, "u_time");

    const colorAUnif = gl.getUniformLocation(program, "u_color_a");
    const colorBUnif = gl.getUniformLocation(program, "u_color_b");
    const biasUnif = gl.getUniformLocation(program, "u_bias");
    const ditherSizeUnif = gl.getUniformLocation(program, "u_dither_size");
    const directionUnif = gl.getUniformLocation(program, "u_direction");
    const offsetUnif = gl.getUniformLocation(program, "u_offset");

    const openPaneBtn = document.getElementById(
      "open-pane",
    )! as HTMLButtonElement;
    const headerElt = document.getElementById("header")!;
    const contentElt = document.getElementById("content")!;

    const hidePage = () => {
      headerElt
        .animate([{ opacity: 0 }], KEYFRAME_ANIM_OPTS)
        .addEventListener("finish", (ev) => {
          commitStyleAnimation(ev);
          headerElt.style.display = "none";
          openPaneBtn.dataset["show"] = "false";
        });
      contentElt
        .animate([{ opacity: 0 }], KEYFRAME_ANIM_OPTS)
        .addEventListener("finish", (ev) => {
          commitStyleAnimation(ev);
          contentElt.style.display = "none";
          openPaneBtn.dataset["show"] = "false";
        });
    };
    const showPage = () => {
      headerElt.style.display = "block";
      contentElt.style.display = "block";
      openPaneBtn.dataset["show"] = "true";
      headerElt
        .animate([{ opacity: 1 }], KEYFRAME_ANIM_OPTS)
        .addEventListener("finish", commitStyleAnimation);
      contentElt
        .animate([{ opacity: 1 }], KEYFRAME_ANIM_OPTS)
        .addEventListener("finish", commitStyleAnimation);
    };

    openPaneBtn.addEventListener("click", () => {
      if (openPaneBtn.dataset["init"] === "true") return;

      openPaneBtn.dataset["init"] = "true";
      openPaneBtn.classList.remove(
        "link-primary",
        "rounded-sm",
        "bg-sweater-9",
        "px-1.25",
        "hover:bg-sweater-8",
        "light:bg-sweater-2",
        "light:hover:bg-sweater-3",
      );

      hidePage();
    });

    const prefersDarkQuery = window.matchMedia("(prefers-color-scheme: dark)");
    const data = {
      dimensions: `${CANVAS_WIDTH}×${CANVAS_HEIGHT}`,
      backend: "WebGL 2",
      color: {
        a: prefersDarkQuery ? SWEATER_9 : SWEATER_3,
        b: prefersDarkQuery ? SWEATER_10 : SWEATER_1,
      },
      bias: 0,
      ditherSize: 7,
      direction: { x: 1, y: 1 },
      offset: { x: 0.0, y: 0.0 },
    };

    gl.uniform3f(colorAUnif, data.color.a.r, data.color.a.g, data.color.a.b);
    gl.uniform3f(colorBUnif, data.color.b.r, data.color.b.g, data.color.b.b);
    gl.uniform1i(ditherSizeUnif, data.ditherSize);
    gl.uniform2f(directionUnif, -data.direction.x, data.direction.y);
    gl.uniform2f(offsetUnif, data.offset.x, data.offset.y);

    const pane = new Pane({
      container: document.getElementById("pane-container")!,
    });
    pane.registerPlugin(TpEssentialsPlugin);

    const drawBlade = pane.addBlade({
      view: "fpsgraph",
      label: "FPS",
      min: 0,
      max: 60,
      rows: 1,
    }) as FpsGraphBladeApi;
    drawBlade.on("tick", (ev) => {
      // Dynamically adjust FPS max bound
      if (ev.target.fps && ev.target.fps > ev.target.max) {
        ev.target.max = ev.target.fps + 15;
      }
    });

    pane.addBinding(data, "dimensions", {
      readonly: true,
      label: "Dimensions",
    });
    pane.addBinding(data, "backend", {
      readonly: true,
      label: "Backend",
    });

    pane.addBlade({ view: "separator" });

    pane
      .addButton({
        title: "Toggle page",
      })
      .on("click", () => {
        if (openPaneBtn.dataset["show"] === "true") {
          hidePage();
        } else {
          showPage();
        }
      });

    pane.addBlade({ view: "separator" });

    const settings = pane.addFolder({
      title: "Settings",
      expanded: true,
    });

    settings
      .addBinding(data.color, "a", {
        label: "Color A",
        color: { type: "float" },
        picker: "inline",
      })
      .on("change", (ev) => {
        gl.uniform3f(colorAUnif, ev.value.r, ev.value.g, ev.value.b);
      });
    settings
      .addBinding(data.color, "b", {
        label: "Color B",
        color: { type: "float" },
        picker: "inline",
      })
      .on("change", (ev) => {
        gl.uniform3f(colorBUnif, ev.value.r, ev.value.g, ev.value.b);
      });
    settings
      .addBinding(data, "bias", { label: "Color bias", min: -1.0, max: 1.0 })
      .on("change", (ev) => {
        gl.uniform1f(biasUnif, ev.value);
      });
    settings
      .addBinding(data, "ditherSize", {
        label: "Dither size",
        min: 1,
        step: 1,
      })
      .on("change", (ev) => {
        gl.uniform1i(ditherSizeUnif, ev.value);
      });
    settings
      .addBinding(data, "direction", {
        label: "Direction",
        x: { min: -1, max: 1, step: 0.01 },
        y: { min: -1, max: 1, step: 0.01 },
        picker: "inline",
      })
      .on("change", (ev) => {
        gl.uniform2f(directionUnif, -ev.value.x, ev.value.y);
      });
    settings
      .addBinding(data, "offset", { label: "Offset", picker: "inline" })
      .on("change", (ev) => {
        gl.uniform2f(offsetUnif, ev.value.x, ev.value.y);
      });

    const draw: FrameRequestCallback = (now) => {
      drawBlade.begin();
      const elapsed = now * 0.001;

      gl.uniform1f(timeUnif, elapsed);
      checkForResize(gl, offCanvas, canvasElt, dimensionsUnif);
      data.dimensions = `${gl.canvas.width}×${gl.canvas.height}`;
      const t = Math.min(elapsed / 5, 1);
      const biasValue = lerp(0.0, -1.0, Math.pow(1 - t, 5));
      gl.uniform1f(biasUnif, biasValue + data.bias);

      gl.clearColor(0.0, 0.0, 0.0, 0.0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      bitmapCtx.transferFromImageBitmap(offCanvas.transferToImageBitmap());

      drawBlade.end();
      requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);
  };

  run();
</script>

<style>
  main {
    /* Force Tweakpane to use my Maple Mono settings */
    #pane-container {
      font-feature-settings: var(--font-mono--font-feature-settings);

      /* Make Tweakpane use Maple Mono */
      --tp-base-font-family: var(--font-mono);
    }
  }
</style>
