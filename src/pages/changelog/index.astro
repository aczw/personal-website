---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import {
  ArrowRightIcon,
  CalendarFoldIcon,
  GitCommitHorizontalIcon,
} from "@lucide/astro";

import BaseLayout from "@/components/base-layout.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import { ICON_SIZE } from "@/scripts/constants";
import Time from "@/components/time.astro";
import MdxContent from "@/components/mdx-content.astro";

const changelogEntries = await getCollection("changelog");
changelogEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const description = "I obsessively tinker with my website, if you can't tell.";
---

<BaseLayout
  meta={{
    kind: "route",
    route: "changelog",
    description,
  }}
>
  <Header />

  <main>
    <hgroup class="constrain px-5">
      <h1 class="sr-only">Art</h1>
      <p class="prose">{description}</p>
      <p class="prose mt-3">
        This is a changelog for this place, documenting all the changes and
        revisions it has been through.{" "}
        <span class="italic">It's been through a lot.</span>
      </p>
    </hgroup>

    <section class="constrain mt-7">
      <h2 class="sr-only">Changelog entries</h2>

      <div class="space-y-7">
        {changelogEntries.map(async (entry) => {
          const { id, data } = entry;
          const inline = data.inline;
          const colCount = Math.max(4, data.covers ? data.covers.length : 0);

          return (
            <article>
              <div class="px-5">
                <div class="flex border-t-2 border-style pt-1 flex-col sm:flex-row prose gap-x-3 justify-between">
                  <hgroup class="flex gap-x-1.5 items-center relative group">
                    <h3
                      class:list={[
                        inline ? "font-medium heading" : "link-primary",
                      ]}
                    >
                      {inline ?
                        <>v{id}</>
                      : <a href={`/changelog/${id}`} class="link-expand">
                          v{id}
                        </a>
                      }
                    </h3>

                    {!inline && (
                      <p class="flex link-secondary items-center gap-x-1.5 group-hover:text-sweater-4 light:group-hover:text-sweater-7">
                        Read <ArrowRightIcon size={ICON_SIZE} class="icon" />
                      </p>
                    )}
                  </hgroup>

                  <div class="flex gap-x-3">
                    <p class="text-sweater-6 light:text-sweater-5 flex gap-x-1.5 items-center">
                      <CalendarFoldIcon size={ICON_SIZE} class="icon" />
                      <Time date={data.date} />
                    </p>

                    <p
                      title={`Git commit SHA1: ${data.commit}`}
                      class="text-sweater-6 light:text-sweater-5 flex gap-x-1.5 items-center maple"
                    >
                      <GitCommitHorizontalIcon size={ICON_SIZE} />{" "}
                      {data.commit.slice(0, 7)}
                    </p>
                  </div>
                </div>
              </div>

              {inline && (
                <MdxContent
                  content={(await render(entry)).Content}
                  class="mt-1.5"
                />
              )}

              {data.covers && (
                <figure class="mt-3 px-5 max-w-(--wide-w) w-full">
                  <figcaption class="sr-only">Screenshots</figcaption>
                  <div
                    class="grid grid-cols-(--col-count) gap-x-1 sm:gap-x-3"
                    style={{
                      "--col-count": `repeat(${colCount}, minmax(0, 1fr))`,
                    }}
                  >
                    {data.covers.map((cover) => (
                      <Image
                        src={cover.file}
                        alt={cover.alt}
                        class="rounded-xs border border-style"
                      />
                    ))}
                  </div>
                </figure>
              )}
            </article>
          );
        })}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
