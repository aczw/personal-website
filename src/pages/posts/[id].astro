---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths } from "astro";

import { CalendarFoldIcon } from "@lucide/astro";

import { DISABLED_POSTS, ICON_SIZE } from "@/scripts/constants";
import BaseLayout from "@/components/base-layout.astro";
import MdxContent from "@/components/mdx-content.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import Time from "@/components/time.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts
    .filter(({ id }) => !DISABLED_POSTS.includes(id))
    .map((post) => {
      return { params: { id: post.id } };
    });
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const post = await getEntry("posts", id)!;

const {
  data: { title, description: blurb, posted, coverImage },
} = post;

const { Content } = await render(post);
---

<BaseLayout meta={{ kind: "posts", postsEntry: post }}>
  <Header />

  <main>
    <div class="constrain md:px-5">
      <div class="px-5 md:px-0">
        <h1 class="text-xl/tight font-medium heading">{title}</h1>
        {blurb && <p class="text-lg/tight heading">{blurb}</p>}
      </div>

      {coverImage && (
        <Image
          src={coverImage.file}
          alt={coverImage.alt}
          class="mt-7 max-w-(--wide-w) md:rounded-lg"
        />
      )}
    </div>

    <section class="constrain mt-7 px-5">
      <h2 class="flex items-center gap-2 font-medium heading">
        Posted <CalendarFoldIcon size={ICON_SIZE} class="icon" />
      </h2>
      <Time date={posted} />
    </section>

    <MdxContent content={Content} />
  </main>

  <Footer />
</BaseLayout>
