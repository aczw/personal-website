---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/base-layout.astro";
import {
  getFullDateFormatting,
  getMonthDayDateFormatting,
} from "@/scripts/util";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";

const posts = await getCollection("posts");

// Group each post with its corresponding year
const yearPostsMap = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.posted.getFullYear();

  if (!yearPostsMap.has(year)) {
    yearPostsMap.set(year, [post]);
  } else {
    yearPostsMap.get(year)!.push(post);
  }
}

// Sort each group of posts
for (const postsInYear of yearPostsMap.values()) {
  postsInYear.sort((a, b) => b.data.posted.getTime() - a.data.posted.getTime());
}

// Sort most recent year on top
const yearPosts = [...yearPostsMap].sort((a, b) => b[0] - a[0]);

const description =
  "Whenever I'm feeling brave enough to write something and put it online for everyone to see I'll post it here.";
---

<BaseLayout meta={{ kind: "route", route: "posts", description }}>
  <Header />

  <main>
    <div class="constrain px-5">
      <h1 class="sr-only">Writing</h1>
      <p class="prose">{description}</p>
    </div>

    <section class="constrain mt-7">
      <h2 class="sr-only">Entries</h2>

      <div class="px-5 [--date-w:8rem] sm:[--date-w:15rem]">
        {yearPosts.map(([year, posts]) => (
          <Fragment>
            <h3
              id={year.toString()}
              class="font-medium heading not-first:mt-3 sm:sr-only"
            >
              {year}
            </h3>

            <ul class="mt-3 pb-1 *:grid *:w-fit *:grid-cols-[var(--date-w)_minmax(0,1fr)] sm:mt-0 sm:*:min-w-(--prose-w)">
              {posts.map(({ data: { title, posted }, id }, index) => {
                const monthDay = getMonthDayDateFormatting(posted);
                const [month, day] = monthDay.split(" ");
                const previousPost = posts[index - 1];

                const hasSameYearAsLast =
                  previousPost?.data.posted.getFullYear() ===
                  posted.getFullYear();
                const hasSameMonthAsLast =
                  previousPost?.data.posted.getUTCMonth() ===
                  posted.getUTCMonth();

                return (
                  <li class="group relative not-last:pb-1">
                    <time
                      datetime={posted.toISOString()}
                      title={getFullDateFormatting(posted)}
                      class="grid grid-cols-1 link-secondary group-hover:text-sweater-4 sm:grid-cols-4 light:group-hover:text-sweater-7"
                    >
                      <span
                        class:list={[
                          "hidden sm:inline",
                          {
                            "opacity-0 group-hover:opacity-100":
                              hasSameYearAsLast,
                          },
                        ]}
                      >
                        {posted.getFullYear()}
                      </span>
                      <span
                        class:list={[
                          "col-span-2 hidden sm:inline",
                          {
                            "opacity-0 group-hover:opacity-100":
                              hasSameMonthAsLast,
                          },
                        ]}
                      >
                        {month}
                      </span>
                      <span class="hidden sm:inline">{day}</span>
                      <span class="sm:hidden">{monthDay}</span>
                    </time>

                    <h4>
                      <a
                        href={`/posts/${id}`}
                        class="link-primary after:absolute after:inset-0 after:z-1"
                      >
                        {title}
                      </a>
                    </h4>
                  </li>
                );
              })}
            </ul>
          </Fragment>
        ))}
      </div>
    </section>

    <section class="constrain mt-7 px-5">
      <h2 id="otherworld" class="font-medium heading">
        otherworld
      </h2>
      <p class="prose">
        In the spirit of digital gardens, notes that I took across my years at
        Penn are available at{" "}
        <a
          href="https://otherworld.czw.sh"
          target="_blank"
          rel="noopener"
          class="link-primary"
        >
          otherworld.czw.sh
        </a>{" "}
        and maybe you'll find them useful.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
