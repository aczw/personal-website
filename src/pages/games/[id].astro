---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";

import BaseLayout from "@/components/base-layout.astro";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import TechList from "@/components/tech-list.astro";
import { getShortDateFormatting } from "@/scripts/util";
import { ArrowLeftIcon, ExternalLinkIcon } from "@lucide/astro";
import { ICON_SIZE } from "@/scripts/constants";
import MdxContent from "@/components/mdx-content.astro";
import Youtube from "@/components/mdx/youtube.astro";

export const getStaticPaths = (async () => {
  const games = await getCollection("games");
  return games.map((game) => {
    return { params: { id: game.id } };
  });
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const game = await getEntry("games", id)!;

const { title, description, instructions, meta, itch, steam } = game.data;

// itch.io adds its own 20px tall bottom bar to the embed, which the
// aspect ratio must take into account
let trueAspectRatio = 0;
if (itch && itch.webEmbed) {
  const { aspectRatio } = itch.webEmbed;
  const ratioValue = aspectRatio.y / aspectRatio.x;

  // Should be kept in sync with var(--max-w)
  const baseHeight = 75 * ratioValue;
  // 20px converted to rem using base font size of 16px
  const trueHeight = baseHeight + 1.25;

  trueAspectRatio = Math.round((75 / trueHeight) * 100);
}

const { Content } = await render(game);
---

<BaseLayout meta={{ kind: "games", gamesEntry: game }}>
  <Header />

  <main>
    <hgroup class="constrain px-5">
      <h1 class="prose text-xl/tight font-medium heading">{title}</h1>
      <p class="prose text-lg/tight heading">{description}</p>
      <p>
        <a
          href="/games"
          class="mt-5 flex link-primary w-fit items-center gap-1.5"
        >
          <ArrowLeftIcon size={ICON_SIZE} /> Back to all games
        </a>
      </p>
    </hgroup>

    {itch && itch.webEmbed && (
      <section class="constrain mt-7 lg:px-5">
        <iframe
          frameborder="0"
          src={`https://itch.io/embed-upload/${itch.webEmbed.id}?color=000000`}
          allowfullscreen=""
          class="w-full overflow-hidden rounded-sm"
          style={{
            aspectRatio: `${trueAspectRatio} / 100`,
          }}
        ></iframe>
      </section>
    )}

    {steam && (
      <section class="constrain mt-7 md:px-5">
        <Youtube
          id={steam.trailer.youTubeId}
          title={steam.trailer.title}
          class="w-full max-w-(--wide-w) overflow-hidden md:rounded-sm"
        />
      </section>
    )}

    <section class="constrain mt-7 px-5">
      <h2 class="sr-only">Overview</h2>

      <dl class="grid max-w-(--prose-w) grid-cols-2 gap-3 md:max-w-150">
        <div>
          <dt class="leading-tight font-medium heading">Built with</dt>
          <dd>
            <TechList tech={meta.tech} />
          </dd>
        </div>

        <div>
          <dt class="leading-tight font-medium heading">Released</dt>
          <dd>{getShortDateFormatting(meta.released)}</dd>
        </div>
      </dl>

      <p class="mt-5 prose rounded-sm bg-sweater-9 p-2 leading-tight light:bg-sweater-2">
        <span class="font-medium">Instructions:</span> {instructions}
      </p>

      {meta.sourceHref && (
        <a
          href={meta.sourceHref}
          target="_blank"
          rel="noopener"
          class="mt-1.5 flex link-primary w-full max-w-(--prose-w) items-center justify-between gap-x-5 rounded-sm border-2 border-style p-2 leading-tight font-medium"
        >
          Source code is available on GitHub
          <ExternalLinkIcon size={ICON_SIZE} class="shrink-0" />
        </a>
      )}

      {itch && (
        <div
          class:list={[
            "relative flex w-full max-w-(--prose-w) items-center justify-between gap-x-5 rounded-sm border-2 border-style p-2 leading-tight",
            meta.sourceHref ? "mt-1.5" : "mt-5",
          ]}
        >
          <div>
            <h3 class="font-medium">
              <a
                href={itch.url}
                target="_blank"
                rel="noopener"
                class="link-primary after:absolute after:inset-0 after:z-1"
              >
                Available on itch.io
              </a>
            </h3>

            <p>
              {(
                itch.download.windows ||
                itch.download.mac ||
                itch.download.linux
              ) ?
                <>
                  Online or download for{" "}
                  {itch.download.windows && <span>Windows</span>}
                  {itch.download.mac && <span>, macOS</span>}
                  {itch.download.linux && <span>, Linux</span>}
                </>
              : <>Play in your browser!</>}
            </p>
          </div>

          <ExternalLinkIcon size={ICON_SIZE} class="shrink-0" />
        </div>
      )}

      {steam && <iframe
        src={`https://store.steampowered.com/widget/${steam.id}`}
        frameborder="0"
        height="190"
        class:list={[
          "w-full max-w-(--prose-w) scheme-light",
          !meta.sourceHref && !itch ? "mt-5" : "mt-1.5",
        ]}
      ></iframe>}
    </section>

    <MdxContent content={Content} />
  </main>

  <Footer />
</BaseLayout>
