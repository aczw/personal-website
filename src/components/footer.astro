---
import { ArrowUpToLineIcon } from "@lucide/astro";

import { ICON_SIZE } from "@/scripts/constants";
---

<footer class="constrain mt-7 mb-6 px-5 sm:mb-20">
  <p class="prose">
    Please, reach out to say hello. I live in Los Angeles, where the time is
    currently{" "}
    <span class="whitespace-nowrap">
      <span id="time-hour">12</span>
      <span id="time-colon" style={{ opacity: 1 }}>
        :
      </span>
      <span id="time-minutes">00</span> <span id="time-period">AM</span>
    </span>
    . Come find me!
  </p>

  <div class="mt-5 prose space-y-3 border-t-2 border-style pt-0.5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex gap-4 *:link-primary">
        <a href="mailto:hi@charleszw.com?subject=hello%20hello&body=i%20love%20how%20your%20website%20looks soooooo%20much">
          Email
        </a>
        <a href="https://www.are.na/charles-zw" target="_blank" rel="noopener">
          Are.na
        </a>
        <a
          href="https://www.linkedin.com/in/zwcharl"
          target="_blank"
          rel="noopener"
        >
          LinkedIn
        </a>
      </div>

      <a href="#" class="flex items-center gap-1.5 link-secondary">
        Back to top <ArrowUpToLineIcon size={ICON_SIZE} />
      </a>
    </div>

    <figure
      id="flavor"
      class="h-[3lh] w-full max-w-80 cursor-default text-sm leading-snug text-pretty"
      style={{ opacity: 0 }}
    >
      <blockquote class="text-sweater-6 inline light:text-sweater-5 italic"></blockquote>{" "}
      <figcaption class="before:content-['—_'] inline w-fit text-sweater-7 light:hover:text-sweater-6 light:text-sweater-4 hover:text-sweater-5"></figcaption>
    </figure>
  </div>
</footer>

<script>
  import { commitStyleAnimation } from "@/scripts/util";
  import { flatLyrics } from "@/scripts/lyrics";

  const flavorElt = document.getElementById("flavor")!;
  const lyricsElt = flavorElt.querySelector("blockquote")!;
  const creditElt = flavorElt.querySelector("figcaption")!;

  const showFlavorText = () => {
    const flat = flatLyrics[Math.floor(Math.random() * flatLyrics.length)]!;
    const lyrics = flat.lyrics.map((lyric) => `“${lyric.trim()}”`).join(" / ");

    lyricsElt.innerText = lyrics;
    creditElt.innerText = `${flat.song}, ${flat.artist}`;
    flavorElt
      .animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 400,
        easing: "ease-out",
        fill: "forwards",
      })
      .addEventListener("finish", commitStyleAnimation);
  };

  creditElt.addEventListener("click", showFlavorText);

  showFlavorText();
</script>

<script>
  import { CURRENT_TIMEZONE } from "@/scripts/constants";

  const hourElt = document.getElementById("time-hour") as HTMLSpanElement;
  const colonElt = document.getElementById("time-colon") as HTMLSpanElement;
  const minsElt = document.getElementById("time-minutes") as HTMLSpanElement;
  const periodElt = document.getElementById("time-period") as HTMLSpanElement;

  const formatter = new Intl.DateTimeFormat("en-US", {
    hour: "numeric",
    minute: "2-digit",
    hour12: true,
    timeZone: CURRENT_TIMEZONE,
  });

  const tick = () => {
    colonElt.style.opacity = colonElt.style.opacity === "1" ? "0" : "1";

    const now = Date.now();

    const parts = formatter.formatToParts(now);
    hourElt.textContent = parts.find((part) => part.type === "hour")!.value;
    minsElt.textContent = parts.find((part) => part.type === "minute")!.value;
    periodElt.textContent = parts.find(
      (part) => part.type === "dayPeriod",
    )!.value;

    const fractMs = now % 1000;
    const delay = 1000 - fractMs;

    window.setTimeout(tick, delay);
  };

  tick();
</script>
