---
/**
 * @see https://web.dev/patterns/web-vitals-patterns/video/video-gif
 */

import type { ContentCollectionKey } from "astro:content";

import { CDN_URL } from "@/scripts/constants";

interface Props {
  content: {
    collection: ContentCollectionKey;
    folder: string;
  };
  name: string;
  hasWebM?: boolean;
}

const {
  content: { collection, folder },
  name,
  hasWebM,
} = Astro.props;

const mediaUrl = `${CDN_URL}/${collection}/${folder}`;
---

<video autoplay loop muted playsinline>
  {hasWebM && <source src={`${mediaUrl}/${name}.webm`} type="video/webm" />}
  <source src={`${mediaUrl}/${name}.mp4`} type="video/mp4" />
</video>
