---
import { actions } from "astro:actions";
import { Image } from "astro:assets";

import { MusicIcon } from "@lucide/astro";

import spiralWebp from "@/assets/spiral.webp";

import Link from "@/components/link.astro";
import { ICON_SIZE } from "@/scripts/constants";
import MusicIndicator from "@/components/music-indicator.astro";

const { data, error } = await Astro.callAction(
  actions.lastFm.getRecentTrack,
  {},
);

const available = !error && false;
---

<div class="opacity-100 flex gap-x-3 transition-opacity duration-600 starting:opacity-0">
  {available ?
    data.coverUrl ?
      <Image
        src={data.coverUrl}
        alt={`Art for ${data.songName} by ${data.artist}`}
        inferSize
        priority
        class="shrink-0 rounded-sm bg-sweater-9 light:bg-sweater-2"
        style={{ height: "5lh", width: "5lh" }}
      />
    : <div class="flex size-[5lh] shrink-0 items-center justify-center rounded-sm bg-sweater-9 light:bg-sweater-2">
        <MusicIcon size={ICON_SIZE} class="stroke-icon" />
      </div>

  : <Image
      src={spiralWebp}
      alt='Blue parking lot with a "Building 9" label. Cover art for my playlist called "spiral."'
      class="size-[5lh] rounded-sm shrink-0 bg-sweater-9 light:bg-sweater-2"
    />
  }

  <div class="flex flex-col justify-between">
    <p>
      {available ?
        <>
          <a
            href={data.songUrl}
            target="_blank"
            rel="noopener"
            title={data.songName}
            class="link-primary"
          >
            {data.songName}
          </a>
          <span title={data.artist} class="line-clamp-1">
            by <span class="font-medium text-sweater-2">{data.artist}</span>
          </span>
          <span title={data.album} class="line-clamp-1">
            from <span class="font-medium text-sweater-2">{data.album}</span>
          </span>
        </>
      : <>
          {/* I've been tracking my music listening history since 2021. It's fun to
          see the trends!{" "}
          <Link href="https://www.last.fm/user/ashzw" target="_blank">
            View my scrobbles.
          </Link> */}
          <a
            href="https://open.spotify.com/playlist/70aHsVCcPmfUOXqCtCK3xy"
            target="_blank"
            rel="noopener"
            class="link-primary"
          >
            spiral
          </a>
        </>
      }
    </p>

    <div
      class="flex items-center gap-1.5"
      title={
        available && data.live ?
          "live, at this current moment in time, wherever you are"
        : null
      }
    >
      <p class="text-sweater-7 light:text-sweater-5">
        {available ?
          data.live ?
            "Playing right now."
          : "Played 10 hours ago."
        : "Last.fm"}
      </p>

      <MusicIndicator size={ICON_SIZE} />
    </div>
  </div>
</div>
