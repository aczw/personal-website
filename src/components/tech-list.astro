---
interface Props {
  tech: string[];
}

const { tech } = Astro.props;
---

<ul class="flex flex-wrap gap-x-1 leading-none">
  {tech.map((item, index) => (
    <li class="text-link-secondary">
      {item}{" "}
      {index !== tech.length - 1 ?
        <span
          aria-hidden="true"
          class="text-sweater-7 select-none light:text-sweater-4"
        >
          /
        </span>
      : null}
    </li>
  ))}
</ul>
