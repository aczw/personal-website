---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ul"> & {
  tech: string[];
};

const { tech, class: className, ...props } = Astro.props;
---

<ul class:list={["flex flex-wrap gap-x-1", className]} {...props}>
  {tech.map((item, index) => (
    <li>
      {item}{" "}
      {index !== tech.length - 1 ?
        <span
          aria-hidden="true"
          class="text-sweater-7 select-none light:text-sweater-4"
        >
          /
        </span>
      : null}
    </li>
  ))}
</ul>
