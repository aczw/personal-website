---
import type { CollectionEntry, CollectionKey } from "astro:content";
import { Font } from "astro:assets";

import SpeedInsights from "@vercel/speed-insights/astro";

import "@/main.css";

import {
  capitalize,
  getShortDateFormatting,
  stripEndingSlash,
} from "@/scripts/util";
import { SITE_URL } from "@/scripts/constants";

/**
 * Essentially maps to every unique page on the site except for
 * content collection entries.
 */
type Route = "home" | "404" | "projects" | "posts" | "about";

/**
 * Maps every content collection name to a literal "kind" and creates a
 * discriminated union out of all collections.
 */
type CollectionKind = {
  [Collection in CollectionKey]: {
    kind: Collection;
  } & {
    [K in Collection as `${K}Entry`]: CollectionEntry<Collection>;
  };
}[CollectionKey];

type Meta =
  { kind: "route"; route: Route; description: string } | CollectionKind;

interface Props {
  meta: Meta;
}

const { meta } = Astro.props;

const head: {
  title: string;
  description: string;
} = (() => {
  switch (meta.kind) {
    case "route": {
      const title = (() => {
        switch (meta.route) {
          case "home":
            return "";
          case "projects":
            return "Projects";
          case "posts":
            return "Writing";
          default:
            return capitalize(meta.route);
        }
      })();

      return {
        title,
        description: meta.description,
      };
    }

    case "projects": {
      const { data } = meta.projectsEntry;
      return {
        title: data.name,
        description: data.description.long,
      };
    }

    case "posts": {
      const { data } = meta.postsEntry;
      const description =
        data.description !== undefined ?
          data.description
        : `Posted on ${getShortDateFormatting(data.posted)}`;

      return {
        title: data.title,
        description,
      };
    }

    default:
      throw new Error("Unhandled meta kind!");
  }
})();

const url = new URL(Astro.url.pathname, Astro.site).toString();
const canonicalUrl = stripEndingSlash(url);

const { title: titlePrefix, description } = head;

const title =
  titlePrefix.length === 0 ? "Charles Wang" : `${titlePrefix} / Charles Wang`;

const OG_URL = `${SITE_URL}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, interactive-widget=resizes-content"
    />
    <meta name="generator" content={Astro.generator} />

    <meta name="color-scheme" content="dark light" />

    <meta property="og:site_name" content="Charles Wang" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={OG_URL} />

    <meta property="twitter:image" content={OG_URL} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="icon"
      sizes="any"
      type="image/svg+xml"
      href="/favicon-dark-bg.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      sizes="any"
      type="image/svg+xml"
      href="/favicon-light-bg.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      sizes="64x64"
      type="image/png"
      href="/favicon-dark-bg.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      sizes="64x64"
      type="image/png"
      href="/favicon-light-bg.png"
      media="(prefers-color-scheme: dark)"
    />

    <title>{title}</title>

    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="9ccfaf2d-6989-4335-ab83-606d54cdee0f"
    ></script>
    <SpeedInsights />

    <Font cssVariable="--font-atkinson" preload />
    <Font cssVariable="--font-maple" preload />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  @reference "@/main.css";

  :root {
    color-scheme: light dark;

    --max-w: 75rem; /* 1200px */
    --wide-w: 56.25rem; /* 900px */
    --prose-w: 34.375rem; /* 550px */
  }

  html {
    background-color: var(--color-sweater-10);
    color: var(--color-sweater-1);

    scrollbar-width: thin;
    scrollbar-gutter: stable;

    &::selection {
      background-color: var(--color-sweater-8);
      color: var(--color-sweater-3);
    }

    @variant light {
      background-color: var(--color-sweater-1);
      color: var(--color-sweater-10);

      &::selection {
        background-color: var(--color-sweater-3);
        color: var(--color-sweater-8);
      }
    }
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  img,
  video {
    font-style: italic;

    &::selection {
      background-color: var(--color-sweater-5);
    }

    @variant light {
      &::selection {
        background-color: var(--color-sweater-3);
      }
    }
  }
</style>
