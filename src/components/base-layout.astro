---
import { Font } from "astro:assets";

import SpeedInsights from "@vercel/speed-insights/astro";

import "@/styles/main.css";

import type { Meta, MetaKind } from "@/scripts/types";
import {
  capitalize,
  getShortDateFormatting,
  stripEndingSlash,
} from "@/scripts/util";
import { SITE_URL } from "@/scripts/constants";

interface Props {
  meta: Meta;
}

type Head = {
  title: string;
  description: string;
  og: `?${MetaKind}=${string}`;
};

const head: Head = (() => {
  const { meta } = Astro.props;

  switch (meta.kind) {
    case "route": {
      const title = (() => {
        switch (meta.route) {
          case "home":
            return "";
          case "projects":
            return "Projects";
          case "posts":
            return "Writing";
          default:
            return capitalize(meta.route);
        }
      })();

      return {
        title,
        description: meta.description,
        og: `?route=${meta.route}`,
      };
    }

    case "projects": {
      const { data, id } = meta.projectsEntry;
      return {
        title: data.name,
        description: data.description.long,
        og: `?projects=${id}`,
      };
    }

    case "posts": {
      const { data, id } = meta.postsEntry;
      const description =
        data.description !== undefined ?
          data.description
        : `Posted on ${getShortDateFormatting(data.posted)}`;

      return {
        title: data.title,
        description,
        og: `?posts=${id}`,
      };
    }

    default:
      throw new Error("Unhandled meta kind!");
  }
})();

const url = new URL(Astro.url.pathname, Astro.site).toString();
const canonicalUrl = stripEndingSlash(url);

const { title: titlePrefix, description, og } = head;
const ogImageUrl = `${SITE_URL}/api/og.png${og}`;

const title =
  titlePrefix.length === 0 ? "Charles Wang" : `${titlePrefix} / Charles Wang`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, interactive-widget=resizes-content"
    />
    <meta name="generator" content={Astro.generator} />

    <meta name="color-scheme" content="dark light" />

    <meta property="og:site_name" content="Charles Wang" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />

    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="icon"
      sizes="any"
      type="image/svg+xml"
      href="/favicon-dark-bg.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      sizes="any"
      type="image/svg+xml"
      href="/favicon-light-bg.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      sizes="64x64"
      type="image/png"
      href="/favicon-dark-bg.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      sizes="64x64"
      type="image/png"
      href="/favicon-light-bg.png"
      media="(prefers-color-scheme: dark)"
    />

    <title>{title}</title>

    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="9ccfaf2d-6989-4335-ab83-606d54cdee0f"
    ></script>
    <SpeedInsights />

    <Font cssVariable="--font-atkinson" preload />
    <Font cssVariable="--font-maple" preload />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  @reference "@/styles/main.css";

  :root {
    color-scheme: light dark;

    --max-w: 75rem; /* 1200px */
    --wide-w: 56.25rem; /* 900px */
    --prose-w: 34.375rem; /* 550px */
  }

  html {
    background-color: var(--color-sweater-10);
    color: var(--color-sweater-1);

    scrollbar-width: thin;
    scrollbar-gutter: stable;

    &::selection {
      background-color: var(--color-sweater-8);
      color: var(--color-sweater-3);
    }

    @variant light {
      background-color: var(--color-sweater-1);
      color: var(--color-sweater-10);

      &::selection {
        background-color: var(--color-sweater-3);
        color: var(--color-sweater-8);
      }
    }
  }

  p,
  a,
  li,
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  img,
  video {
    font-size: italic;

    &::selection {
      background-color: var(--color-sweater-5);
    }

    @variant light {
      &::selection {
        background-color: var(--color-sweater-3);
      }
    }
  }
</style>

<style is:global>
  @reference "@/styles/main.css";

  :root {
    /* Make Tweakpane use Maple Mono */
    --tp-base-font-family: var(--font-mono);
    --tp-base-shadow-color: transparent;
    --tp-base-border-radius: var(--radius-lg);

    /* Values were built with https://tweakpane.github.io/docs/theming/#builder */
    --tp-base-background-color: hsla(244, 47%, 7%, 1);
    --tp-button-background-color: hsla(244, 36%, 41%, 1);
    --tp-button-background-color-active: rgba(108, 102, 183, 1);
    --tp-button-background-color-focus: rgba(91, 85, 175, 1);
    --tp-button-background-color-hover: rgba(81, 75, 160, 1);
    --tp-button-foreground-color: hsla(244, 100%, 94%, 1);
    --tp-container-background-color: hsla(247, 42%, 17%, 0.5);
    --tp-container-background-color-active: rgba(55, 47, 116, 0.5);
    --tp-container-background-color-focus: rgba(47, 40, 98, 0.5);
    --tp-container-background-color-hover: rgba(38, 33, 80, 0.5);
    --tp-container-foreground-color: hsla(244, 100%, 94%, 1);
    --tp-groove-foreground-color: hsla(247, 42%, 17%, 0.5);
    --tp-input-background-color: hsla(247, 42%, 17%, 1);
    --tp-input-background-color-active: hsla(247, 42%, 32%, 1);
    --tp-input-background-color-focus: hsla(247, 42%, 27%, 1);
    --tp-input-background-color-hover: hsla(246, 42%, 22%, 1);
    --tp-input-foreground-color: hsla(244, 100%, 91%, 1);
    --tp-label-foreground-color: hsla(244, 100%, 94%, 1);
    --tp-monitor-background-color: hsla(247, 42%, 17%, 1);
    --tp-monitor-foreground-color: hsla(244, 100%, 94%, 1);

    @variant light {
      --tp-base-background-color: hsla(244, 100%, 94%, 1);
      --tp-button-background-color: hsla(245, 100%, 83%, 1);
      --tp-button-background-color-active: rgba(105, 92, 255, 1);
      --tp-button-background-color-focus: rgba(129, 117, 255, 1);
      --tp-button-background-color-hover: rgba(152, 143, 255, 1);
      --tp-button-foreground-color: hsla(244, 47%, 7%, 1);
      --tp-container-background-color: hsla(245, 100%, 87%, 0.35);
      --tp-container-background-color-active: hsla(245, 100%, 72%, 0.35);
      --tp-container-background-color-focus: hsla(245, 100%, 77%, 0.35);
      --tp-container-background-color-hover: hsla(245, 100%, 82%, 0.35);
      --tp-container-foreground-color: hsla(244, 47%, 7%, 1);
      --tp-groove-foreground-color: hsla(245, 100%, 87%, 0.35);
      --tp-input-background-color: hsla(244, 100%, 91%, 1);
      --tp-input-background-color-active: hsla(244, 100%, 76%, 1);
      --tp-input-background-color-focus: hsla(244, 100%, 81%, 1);
      --tp-input-background-color-hover: hsla(243, 100%, 86%, 1);
      --tp-input-foreground-color: hsla(247, 42%, 17%, 1);
      --tp-label-foreground-color: hsla(244, 47%, 7%, 1);
      --tp-monitor-background-color: hsla(244, 100%, 91%, 1);
      --tp-monitor-foreground-color: hsla(247, 42%, 17%, 1);
    }

    --ec-tm-markBrdCol: --alpha(var(--color-sweater-2) / 30%);
    --ec-tm-markBg: --alpha(var(--color-sweater-2) / 10%);

    /* Taken from Rosé Pine palette */
    --ec-tm-insBg: --alpha(#9ccfd8 / 25%);
    --ec-tm-insBrdCol: --alpha(#9ccfd8 / 50%);
    --ec-tm-insDiffIndCol: --alpha(#9ccfd8 / 65%);
    --ec-tm-delBg: --alpha(#eb6f92 / 25%);
    --ec-tm-delBrdCol: --alpha(#eb6f92 / 50%);
    --ec-tm-delDiffIndCol: --alpha(#eb6f92 / 65%);

    @variant light {
      --ec-tm-markBrdCol: --alpha(var(--color-sweater-9) / 30%);
      --ec-tm-markBg: --alpha(var(--color-sweater-9) / 10%);

      /* Taken from Rosé Pine Dawn palette */
      --ec-tm-insBg: --alpha(#56949f / 25%);
      --ec-tm-insBrdCol: --alpha(#56949f / 50%);
      --ec-tm-insDiffIndCol: --alpha(#56949f / 65%);
      --ec-tm-delBg: --alpha(#b4637a / 25%);
      --ec-tm-delBrdCol: --alpha(#b4637a / 50%);
      --ec-tm-delDiffIndCol: --alpha(#b4637a / 65%);
    }

    --ec-codePadBlk: --spacing(5);
    --ec-codePadInl: --spacing(5);
    --ec-uiPadInl: --spacing(5);
    --ec-uiPadBlk: --spacing(1);

    @variant sm {
      --ec-codePadBlk: --spacing(3);
      --ec-codePadInl: --spacing(3);
      --ec-uiPadInl: --spacing(3);
    }
  }

  /* Force Tweakpane to use my Maple Mono settings */
  .panel-container {
    font-feature-settings: var(--font-mono--font-feature-settings);
  }

  .expressive-code {
    * {
      @apply scrollbar-thin;
    }

    /* Make tab headers bold */
    figure.frame.has-title {
      figcaption.header .title {
        @apply font-medium;
      }
    }

    /* Force EC code blocks to use my Maple Mono settings */
    pre * {
      @apply maple;
    }
  }
</style>
