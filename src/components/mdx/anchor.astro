---
/**
 * - If the link is normal, then this collapses to <a>
 * - If the link is related to footnotes (so either the footnote itself or
 *   the back ref), then we remove target="_blank"
 * - If the link is the footnote itself, we add "[]" brackets and
 *   some scroll top margin
 * - If the link is the back ref, we replace everything with the arrow icon
 *
 * Essentially we hijack MDX's HTML output to replace it with our own.
 */

import type { HTMLAttributes } from "astro/types";

import { Undo2Icon } from "@lucide/astro";

import { ICON_SIZE } from "@/scripts/constants";

type Props = Omit<HTMLAttributes<"a">, "target" | "class">;

const href = Astro.props.href;

if (!href || typeof href !== "string") {
  throw new Error(
    '"href" doesn\'t exist on anchor or we mistakenly passed in a URL object.',
  );
}

const isFootnoteRelated = href.startsWith("#user-content-fn");
const isFootnote = href.startsWith("#user-content-fn-");
const isBackRef = href.startsWith("#user-content-fnref-");
---

<a
  target={isFootnoteRelated ? null : "_blank"}
  rel={isFootnoteRelated ? null : "noopener"}
  class:list={["link-primary w-fit", { "scroll-mt-4": isFootnote }]}
  {...Astro.props}
>
  {isBackRef ?
    <Undo2Icon size={ICON_SIZE} />
  : isFootnote ?
    <>
      [<slot />]
    </>
  : <slot />}
</a>
