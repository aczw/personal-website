---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h4">;

const { id, ...props } = Astro.props;
---

<h4
  id={id}
  class="scroll-mt-4 text-base/tight font-medium text-link-primary hover:text-link-primary-hover"
  {...props}
>
  <a href={`#${id}`} class="w-full block">
    <slot />
  </a>
</h4>
