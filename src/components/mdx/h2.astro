---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h2">;

const { id, ...props } = Astro.props;
---

<h2
  id={id}
  class="scroll-mt-4 mt-5 text-xl/tight font-medium text-link-primary hover:text-link-primary-hover"
  {...props}
>
  <a href={`#${id}`} class="w-full block">
    <slot />
  </a>
</h2>
