---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h2">;

const { id, ...props } = Astro.props;
---

<h2
  id={id}
  class="mt-5 scroll-mt-4 text-xl/tight font-medium text-link-primary hover:text-link-primary-hover"
  {...props}
>
  <a href={`#${id}`} class="block w-full">
    <slot />
  </a>
</h2>
