---
import type { HTMLAttributes } from "astro/types";
import type { CollectionKey } from "astro:content";
import { Image } from "astro:assets";
import type { z } from "astro/zod";

import type { ImageSchema } from "@/scripts/schema";
import { CDN_URL } from "@/scripts/constants";

type Props = Omit<HTMLAttributes<"div">, "style"> & {
  collection: CollectionKey;
  id: string;
  coverImage: z.infer<ReturnType<typeof ImageSchema>>;
};

const { id, collection, coverImage, class: className, ...props } = Astro.props;

const aspectRatio = `${coverImage.file.width} / ${coverImage.file.height}`;
---

<div
  class:list={[
    "relative h-auto w-full overflow-hidden *:absolute *:inset-0",
    className,
  ]}
  style={{ aspectRatio }}
  {...props}
>
  <Image
    src={coverImage.file}
    alt={coverImage.alt}
    decoding="async"
    class="h-auto w-full bg-sweater-9 light:bg-sweater-2"
  />

  <video
    crossorigin="anonymous"
    muted
    playsinline
    loop
    autoplay
    preload="auto"
    src={`${CDN_URL}/${collection}/${id}/cover.mp4`}
    class="video-cover h-auto w-full bg-sweater-9 opacity-0 light:bg-sweater-2"
    data-loaded="false"
  ></video>
</div>

<script>
  import { KEYFRAME_ANIM_OPTS } from "@/scripts/constants";
  import { commitStyleAnimation } from "@/scripts/util";

  const isVideoReady = (videoElt: HTMLVideoElement) => {
    return videoElt.readyState >= HTMLMediaElement.HAVE_ENOUGH_DATA;
  };

  const checkAndTransitionVideo = (
    imageElt: HTMLImageElement,
    videoElt: HTMLVideoElement,
  ) => {
    if (!isVideoReady(videoElt) || videoElt.dataset["loaded"]! === "true") {
      return;
    }

    videoElt.dataset["loaded"] = "true";
    videoElt
      .animate([{ opacity: 1 }], KEYFRAME_ANIM_OPTS)
      .addEventListener("finish", (ev) => {
        commitStyleAnimation(ev);
        imageElt.remove();
      });
  };

  document
    .querySelectorAll<HTMLVideoElement>("video.video-cover")
    .forEach((videoElt) => {
      const imageElt = videoElt.previousElementSibling as HTMLImageElement;

      if (isVideoReady(videoElt)) {
        checkAndTransitionVideo(imageElt, videoElt);
      } else {
        videoElt.addEventListener("progress", () =>
          checkAndTransitionVideo(imageElt, videoElt),
        );
        videoElt.addEventListener("canplaythrough", () =>
          checkAndTransitionVideo(imageElt, videoElt),
        );
      }
    });
</script>
