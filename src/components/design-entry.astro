---
import { Image } from "astro:assets";
import { render, getCollection, type CollectionEntry } from "astro:content";

import {
  ArrowRightIcon,
  CalendarClockIcon,
  ImageIcon,
  WrenchIcon,
} from "@lucide/astro";

import MdxContent from "@/components/mdx-content.astro";
import TechList from "@/components/tech-list.astro";
import { ICON_SIZE } from "@/scripts/constants";
import Time from "@/components/time.astro";

interface Props {
  entry: CollectionEntry<"design"> | CollectionEntry<"designPages">;
}

const { entry } = Astro.props;
const { data } = entry;
const { image, meta } = data;

const designPages = await getCollection("designPages");
const relevantEntries = designPages.filter(
  ({ id }) => id.split("/")[0]! === entry.id,
);
relevantEntries.sort(
  (a, b) => b.data.meta.created.getTime() - a.data.meta.created.getTime(),
);

const { Content } = await render(entry);
---

<section class="constrain mt-7">
  <h2 class="sr-only">Design</h2>

  <div class="px-5">
    <div
      class:list={[
        "max-w-(--wide-w)",
        data.backgroundFor && "p-3 rounded-lg",
        data.backgroundFor &&
          data.backgroundFor === "light-media" &&
          "light:bg-sweater-5",
        data.backgroundFor &&
          data.backgroundFor === "dark-media" &&
          "dark:bg-sweater-6",
      ]}
    >
      <Image
        src={image.file}
        alt={image.alt}
        class="h-auto w-full md:rounded-sm"
      />
    </div>

    {data.backgroundFor && (
      <p
        class:list={[
          "text-sm mt-1 font-medium light:text-sweater-7 text-sweater-5",
          data.backgroundFor === "light-media" && "dark:hidden",
          data.backgroundFor === "dark-media" && "light:hidden",
        ]}
      >
        Note: background applied for visibility.
      </p>
    )}
  </div>
</section>

<section class="constrain mt-7 px-5">
  <h2 class="sr-only">Overview</h2>

  <dl class="grid max-w-(--prose-w) grid-cols-1 gap-3 md:max-w-150 md:grid-cols-3">
    <div>
      <dt class="flex items-center justify-between gap-2 leading-tight font-medium heading md:justify-start">
        Resolution <ImageIcon size={ICON_SIZE} class="icon" />
      </dt>
      <dd>
        {image.file.width}×{image.file.height}
      </dd>
    </div>

    <div>
      <dt class="flex items-center justify-between gap-2 leading-tight font-medium heading md:justify-start">
        Tools <WrenchIcon size={ICON_SIZE} class="icon" />
      </dt>
      <dd>
        <TechList tech={meta.tools} />
      </dd>
    </div>

    <div>
      <dt class="flex items-center justify-between gap-2 leading-tight font-medium heading md:justify-start">
        Created <CalendarClockIcon size={ICON_SIZE} class="icon" />
      </dt>
      <dd>
        <Time date={meta.created} />
      </dd>
    </div>
  </dl>
</section>

{relevantEntries.length > 0 && entry.collection === "design" && (
  <section class="constrain mt-7 px-5">
    <h2 id="subpages" class="text-lg font-medium heading">
      Subpages
    </h2>

    <div class="grid grid-cols-1 mt-1.5 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 *:relative *:h-fit">
      {relevantEntries.map(({ id, data }) => (
        <figure>
          <div
            class:list={[
              "max-w-(--wide-w)",
              data.backgroundFor && "p-3 rounded-lg",
              data.backgroundFor &&
                data.backgroundFor === "light-media" &&
                "light:bg-sweater-5",
              data.backgroundFor &&
                data.backgroundFor === "dark-media" &&
                "dark:bg-sweater-6",
            ]}
          >
            <Image
              src={data.image.file}
              alt={data.image.alt}
              class="rounded-sm"
            />
          </div>

          <figcaption class="pt-1">
            <h3>
              <a
                href={`/design/${id}`}
                class="flex link-primary w-full items-center justify-between gap-x-1.5 leading-snug link-expand sm:justify-start"
              >
                {data.title} <ArrowRightIcon size={ICON_SIZE} />
              </a>
            </h3>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<MdxContent content={Content} class="mt-7" />
