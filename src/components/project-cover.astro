---
import { Image } from "astro:assets";
import type { z } from "astro/zod";

import type { ImageSchema } from "@/content.config";
import { CDN_URL } from "@/scripts/constants";
import { isValidProjectCover } from "@/scripts/util";

interface Props {
  id: string;
  cover: z.infer<ReturnType<typeof ImageSchema>>;
  class?: string;
}

const { id, cover, class: className } = Astro.props;
const path = `${CDN_URL}/projects/${id}`;

if (!isValidProjectCover(cover.data.width, cover.data.height)) {
  throw new Error(
    `Error rendering ${id}: project cover images must have an aspect ratio of 16:10!`,
  );
}
---

<div
  class:list={["relative block aspect-16/10 *:absolute *:inset-0", className]}
>
  <Image src={cover.data} alt={cover.alt} priority class="bg-sweater-9" />

  <div
    style={{ opacity: 0 }}
    class="w-full transition-opacity motion-reduce:hidden"
  >
    <video autoplay loop muted playsinline preload="auto" class="h-full w-full">
      <source src={`${path}/cover.mp4`} type="video/mp4" />
    </video>
  </div>
</div>
