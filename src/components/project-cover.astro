---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import type { z } from "astro/zod";

import type { ImageSchema } from "@/content.config";
import { CDN_URL } from "@/scripts/constants";
import { isValidProjectCover } from "@/scripts/util";

type Props = HTMLAttributes<"div"> & {
  projectId: string;
  coverImage: z.infer<ReturnType<typeof ImageSchema>>;
};

const { projectId, coverImage, class: className, ...props } = Astro.props;

if (!isValidProjectCover(coverImage.data.width, coverImage.data.height)) {
  throw new Error(
    `Project cover image for "${projectId}" does not have 16:10 aspect ratio`,
  );
}
---

<div
  class:list={[
    "relative aspect-16/10 overflow-hidden *:absolute *:inset-0",
    className,
  ]}
  {...props}
>
  <Image
    src={coverImage.data}
    alt={coverImage.alt}
    priority
    decoding="async"
    class="bg-sweater-9 light:bg-sweater-2 w-full h-auto"
  />

  <video
    crossorigin="anonymous"
    muted
    playsinline
    loop
    autoplay
    preload="auto"
    src={`${CDN_URL}/projects/${projectId}/cover.mp4`}
    class="project-cover-video opacity-0 w-full h-auto bg-sweater-9 light:bg-sweater-2"
    data-loaded="false"
  ></video>
</div>

<script>
  import { commitStyleAnimation } from "@/scripts/util";

  const isVideoReady = (videoElt: HTMLVideoElement) => {
    return videoElt.readyState >= HTMLMediaElement.HAVE_ENOUGH_DATA;
  };

  const checkAndTransitionVideo = (
    imageElt: HTMLImageElement,
    videoElt: HTMLVideoElement,
  ) => {
    if (!isVideoReady(videoElt) || videoElt.dataset["loaded"]! === "true") {
      return;
    }

    videoElt.dataset["loaded"] = "true";
    videoElt
      .animate([{ opacity: 1 }], {
        duration: 700,
        // https://easings.net/#easeInOutExpo
        easing: "cubic-bezier(0.87, 0, 0.13, 1)",
        fill: "forwards",
      })
      .addEventListener("finish", (ev) => {
        commitStyleAnimation(ev);
        imageElt.remove();
      });
  };

  document
    .querySelectorAll<HTMLVideoElement>("video.project-cover-video")
    .forEach((videoElt) => {
      const imageElt = videoElt.previousElementSibling as HTMLImageElement;

      if (isVideoReady(videoElt)) {
        checkAndTransitionVideo(imageElt, videoElt);
      } else {
        videoElt.addEventListener("progress", () =>
          checkAndTransitionVideo(imageElt, videoElt),
        );
        videoElt.addEventListener("canplaythrough", () =>
          checkAndTransitionVideo(imageElt, videoElt),
        );
      }
    });
</script>
