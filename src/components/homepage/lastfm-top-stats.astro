---
import { actions } from "astro:actions";
import { Image } from "astro:assets";

import dummyImg from "@/assets/spiral.webp";

const { data, error } = await Astro.callAction(actions.lastFm.getTopStats, {});

const available = !error;
---

<div class="flex gap-x-3 opacity-100 transition-opacity duration-600 starting:opacity-0 w-3/5">
  {Array.from({ length: 3 }).map(() => (
    <Image
      src={dummyImg}
      alt="dummy"
      class="aspect-square object-cover shrink-0 bg-sweater-9 light:bg-sweater-2 rounded-sm size-[5lh]"
    />
  ))}

  <div class="flex flex-col justify-between">
    <p class="font-medium text-heading">
      {available ?
        <>In the last 7 days, my top...</>
      : <>
          According to{" "}
          <a
            href="https://www.last.fm/user/ashzw"
            target="_blank"
            rel="noopener"
            class="link-primary"
          >
            Last.fm
          </a>{" "}
          my top...
        </>
      }
    </p>

    <div>
      {available ?
        <ul class="*:line-clamp-1">
          <li title={data.track.name}>
            <span class="sm:hidden md:inline">...song is </span>
            <a
              href={data.track.url}
              target="_blank"
              rel="noopener"
              class="link-primary"
            >
              {data.track.name}
            </a>{" "}
            ({data.track.count}×)
          </li>

          <li title={data.album.name}>
            <span class="sm:hidden md:inline">...album is </span>
            <a
              href={data.album.url}
              target="_blank"
              rel="noopener"
              class="link-primary"
            >
              {data.album.name}
            </a>{" "}
            ({data.album.count}×)
          </li>

          <li title={data.artist.name}>
            <span class="sm:hidden md:inline">...artist is </span>
            <a
              href={data.artist.url}
              target="_blank"
              rel="noopener"
              class="link-primary"
            >
              {data.artist.name}
            </a>{" "}
            ({data.artist.count}×)
          </li>
        </ul>
      : <p>...song is [this], ...album is [this], ...artist is [this]</p>}
    </div>
  </div>
</div>
