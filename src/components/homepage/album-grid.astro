---
import type { actions, ActionReturnType } from "astro:actions";
import { Image } from "astro:assets";

import { Disc3Icon } from "@lucide/astro";

import { ICON_SIZE } from "@/scripts/constants";

interface Props {
  albums: ActionReturnType<typeof actions.lastFm.getTopAlbums.orThrow>;
}

const { albums } = Astro.props;
---

{albums.map(({ name, coverUrl }) => (
  <li title={name}>
    {coverUrl ?
      <Image
        src={coverUrl}
        alt={`Cover art for ${name}`}
        width={174}
        height={174}
        priority
        class="bg-sweater-9 desktop:rounded-sm aspect-square object-cover light:bg-sweater-2 w-full h-auto"
      />
    : <div class="flex aspect-square items-center justify-center desktop:rounded-sm bg-sweater-9 light:bg-sweater-2 w-full h-auto">
        <Disc3Icon size={2 * ICON_SIZE} class="stroke-icon" />
      </div>
    }
  </li>
))}
