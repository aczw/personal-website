---
import { actions } from "astro:actions";

import TracksList from "@/components/homepage/tracks-list.astro";
import Playlists from "@/components/homepage/playlists.astro";

const { data } = await Astro.callAction(actions.lastFm.getRecentTracks, {
  count: 3,
});
---

<ul class="flex grow flex-col justify-between gap-3 opacity-100 transition-opacity duration-600 starting:opacity-0">
  {data ?
    <TracksList tracks={data} />
  : <Playlists />}
</ul>
