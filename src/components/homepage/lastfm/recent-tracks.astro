---
import { actions } from "astro:actions";

import TracksList from "@/components/homepage/lastfm/tracks-list.astro";
import SpotifyPlaylist from "@/components/homepage/lastfm/spotify-playlist.astro";

const { data } = await Astro.callAction(actions.lastFm.getRecentTracks, {});
---

{data ?
  <TracksList {...data} />
: <SpotifyPlaylist />}
