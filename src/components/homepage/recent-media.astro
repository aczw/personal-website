---
import { actions } from "astro:actions";

import AnimeMangaList from "@/components/homepage/media-list.astro";
import FavoriteAnimeManga from "@/components/homepage/favorite-media.astro";

const { data } = await Astro.callAction(actions.aniList.getRecentActivity, {});
---

{data ?
  <AnimeMangaList activities={data} />
: <FavoriteAnimeManga />}
