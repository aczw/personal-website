---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import yourLieInAprilPng from "@/assets/anilist/your-lie-in-april.png";
import reZeroJpg from "@/assets/anilist/rezero.jpg";
import bloomIntoYouJpg from "@/assets/anilist/bloom-into-you.jpg";
import gijiHaremJpg from "@/assets/anilist/giji-harem.jpg";
import chainsawManPng from "@/assets/anilist/chainsaw-man.png";

const entries: {
  title: string;
  cover: ImageMetadata;
  url: string;
}[] = [
  {
    title: "Your lie in April",
    cover: yourLieInAprilPng,
    url: "https://anilist.co/anime/20665/Your-lie-in-April",
  },
  {
    title: "Re:ZERO",
    cover: reZeroJpg,
    url: "https://anilist.co/anime/21355/ReZERO-Starting-Life-in-Another-World",
  },
  {
    title: "Bloom Into You",
    cover: bloomIntoYouJpg,
    url: "https://anilist.co/manga/86218/Bloom-Into-You",
  },
  {
    title: "Giji Harem",
    cover: gijiHaremJpg,
    url: "https://anilist.co/manga/105577/Giji-Harem",
  },
  {
    title: "Chainsaw Man",
    cover: chainsawManPng,
    url: "https://anilist.co/manga/105778/Chainsaw-Man",
  },
];
---

<div class="space-y-7 opacity-100 transition-opacity duration-600 starting:opacity-0">
  <p class="px-5 prose">Here are some of my favorites.</p>

  <ul class="flex items-end gap-x-3 overflow-x-auto rounded-sm px-5">
    {entries.map(({ title, cover, url }) => (
      <li class="shrink-0">
        <a href={url} title={title} target="_blank" rel="noopener">
          <Image
            src={cover}
            alt={`Cover art for ${title}`}
            priority
            class="rounded-sm bg-sweater-9 light:bg-sweater-2"
            style={{ width: "auto", height: "5.25lh" }}
          />
        </a>
      </li>
    ))}
  </ul>
</div>
