---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import reZeroJpg from "@/assets/anilist/rezero.jpg";
import chainsawManPng from "@/assets/anilist/chainsaw-man.png";
import bloomIntoYouJpg from "@/assets/anilist/bloom-into-you.jpg";
import howDoWeRelationshipPng from "@/assets/anilist/how-do-we-relationship.png";
import kindergartenWarsJpg from "@/assets/anilist/kindergarten-wars.jpg";
import nisekoiJpg from "@/assets/anilist/nisekoi.jpg";
import quintessentialQuintupletsJpg from "@/assets/anilist/quintessential-quintuplets.jpg";

const entries: {
  title: string;
  cover: ImageMetadata;
  url: string;
}[] = [
  {
    title: "Re:ZERO",
    cover: reZeroJpg,
    url: "https://anilist.co/anime/21355/ReZERO-Starting-Life-in-Another-World",
  },
  {
    title: "Chainsaw Man",
    cover: chainsawManPng,
    url: "https://anilist.co/manga/105778/Chainsaw-Man",
  },
  {
    title: "Bloom Into You",
    cover: bloomIntoYouJpg,
    url: "https://anilist.co/manga/86218/Bloom-Into-You",
  },
  {
    title: "How Do We Relationship?",
    cover: howDoWeRelationshipPng,
    url: "https://anilist.co/manga/104241/How-Do-We-Relationship",
  },
  {
    title: "Kindergarten Wars",
    cover: kindergartenWarsJpg,
    url: "https://anilist.co/manga/154349/Kindergarten-Wars",
  },
  {
    title: "Nisekoi",
    cover: nisekoiJpg,
    url: "https://anilist.co/manga/61499/Nisekoi-False-Love",
  },
  {
    title: "Quintessential Quintuplets",
    cover: quintessentialQuintupletsJpg,
    url: "https://anilist.co/manga/100230/The-Quintessential-Quintuplets",
  },
];
---

<div class="space-y-7 opacity-100 transition-opacity duration-600 starting:opacity-0">
  <p class="prose px-5">
    Here are some of my favorites, in no particular order. I've been tracking
    everything{" "}
    <a
      href="https://anilist.co/user/czw"
      target="_blank"
      rel="noopener"
      class="link-primary"
    >
      on AniList
    </a>{" "}
    since I started in 2020. (Follow me.)
  </p>

  <ul class="flex items-end gap-x-3 overflow-x-auto rounded-sm px-5">
    {entries.map(({ title, cover, url }) => (
      <li class="shrink-0">
        <a href={url} title={title} target="_blank" rel="noopener">
          <Image
            src={cover}
            alt={`Cover art for ${title}`}
            priority
            class="rounded-sm bg-sweater-9 light:bg-sweater-2"
            style={{ width: "auto", height: "5.25lh" }}
          />
        </a>
      </li>
    ))}
  </ul>
</div>
