---
import { actions } from "astro:actions";

import AlbumGrid from "@/components/homepage/album-grid.astro";
import FavoriteAlbums from "@/components/homepage/favorite-albums.astro";

const { data } = await Astro.callAction(actions.lastFm.getTopAlbums, {
  count: 8,
});
---

<p class="mb-7 px-5 opacity-100 transition-opacity duration-600 desktop:px-0 starting:opacity-0">
  {data ?
    "In the last 7 days, my top albums are..."
  : "Some of my favorite albums of all time are..."}
</p>

<ul class="grid grid-cols-4 opacity-100 transition-opacity duration-600 desktop:gap-3 starting:opacity-0">
  {data ?
    <AlbumGrid albums={data} />
  : <FavoriteAlbums />}
</ul>
