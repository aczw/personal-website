---
import { Image } from "astro:assets";
import type { ActionReturnType, actions } from "astro:actions";

import type { MediaTitle } from "@/actions/anilist";
import { capitalize, getFullDateFormatting } from "@/scripts/util";
import Aside from "@/components/mdx/aside.astro";

interface Props {
  activities: ActionReturnType<
    typeof actions.aniList.getRecentActivity.orThrow
  >;
}

const getResolvedTitle = (title: MediaTitle) => {
  return (
    title.english ? title.english
    : title.romaji ? title.romaji
    : title.native
  );
};

const relativeTime = (date: Date) => {
  const rtf = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" });
  const diffInDays = Math.ceil(
    // Calculate in terms of days
    ((date.getTime() - Date.now()) * 0.001) / 86400,
  );

  return rtf.format(diffInDays, "day");
};

const { activities } = Astro.props;

const unique: typeof activities = [];
let count = 0;

for (const activity of activities) {
  if (unique.findIndex((act) => act.media.id === activity.media.id) === -1) {
    unique.push(activity);
    count++;

    // Only the 5 most recent unique entries
    if (count === 5) {
      break;
    }
  }
}

const first = unique[0]!;
---

<div class="grid grid-cols-1 gap-x-pad-4 gap-y-pad-2 opacity-100 transition-opacity duration-500 md:grid-cols-2 starting:opacity-0">
  <ul class="flex gap-x-pad overflow-x-auto rounded-md md:justify-between">
    {unique.map(({ media: { title, coverImage, siteUrl } }) => {
      const resolved = getResolvedTitle(title);

      return (
        <li class="shrink-0">
          <a href={siteUrl} title={resolved} target="_blank" class="block">
            <Image
              src={coverImage.large}
              alt={`Cover art for ${resolved}`}
              inferSize
              priority
              class="rounded-md bg-sweater-9"
              style={{ height: "4lh", width: "auto" }}
            />
          </a>
        </li>
      );
    })}
  </ul>

  <div class="max-w-(--content-w) space-y-pad">
    <p
      title={getFullDateFormatting(new Date(first.createdAt * 1000))}
      class="w-fit"
    >
      Latest {first.type === "MANGA_LIST" ? "manga" : "anime"} activity from{" "}
      <time datetime={new Date(first.createdAt * 1000).toISOString()}>
        {relativeTime(new Date(first.createdAt * 1000))}.
      </time>
    </p>
    <Aside>
      <p>
        {capitalize(first.status)}{" "}
        {first.status.includes("complete") ?
          first.type === "MANGA_LIST" ?
            "reading"
          : "watching"
        : null}{" "}
        {first.progress ? `${first.progress} of` : null}{" "}
        <a
          href={first.media.siteUrl}
          target="_blank"
          rel="noopener"
          class="link-primary font-medium"
        >
          {getResolvedTitle(first.media.title)}
        </a>
      </p>
    </Aside>
  </div>
</div>
